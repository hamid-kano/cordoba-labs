rules_version = '2';
// قواعد أمان Firestore لاختبارات الموقع.
// الطالب: بيضيف محاولة بس (بشروط على الحقول)، وما بيقدر يقرا ولا يعدّل ولا يحذف.
// المدرّس: بيقرا ويحذف بس بعد تسجيل الدخول بإيميله. الإيميل لازم يطابق TEACHER_EMAIL بـ src/data/firebase-config.ts.
// انشرها من Firebase Console ← Firestore Database ← Rules: الصق هالملف كله واكبس Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'hamidkano409@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /attempts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['quiz', 'course', 'name', 'sid', 'score', 'total', 'answers', 'qs', 'left', 'secs', 'client', 'at'])
        && request.resource.data.quiz is string && request.resource.data.quiz.size() <= 30
        && request.resource.data.course in ['ai2', 'wireless', 'os1', 'rts']
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.sid is string && request.resource.data.sid.size() >= 1 && request.resource.data.sid.size() <= 20
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 50
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.answers is list && request.resource.data.answers.size() == request.resource.data.total
        && request.resource.data.qs is list && request.resource.data.qs.size() == request.resource.data.total
        && request.resource.data.left is int && request.resource.data.left >= 0 && request.resource.data.left <= 1000
        && request.resource.data.secs is int && request.resource.data.secs >= 0 && request.resource.data.secs <= 36000
        && request.resource.data.client is string && request.resource.data.client.size() <= 20
        && request.resource.data.at == request.time;
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    // ===== مشروع نظم التشغيل 1 (src/scripts/os1Project.ts) =====
    // الإعدادات: الكل بيقرا (لحتى الصفحة تعرف إذا مفتوح)، والمدرّس بس بيكتب. إذا الملف مش موجود، كل شي مقفول.
    function cfg() {
      return get(/databases/$(database)/documents/settings/os1project).data;
    }
    function regOpen() {
      let s = cfg();
      return s.regMode == 'open' || (s.regMode == 'auto' && request.time >= s.regFrom && request.time < s.regTo);
    }
    function subOpen() {
      let s = cfg();
      return s.subMode == 'open' || (s.subMode == 'auto' && request.time < s.subTo);
    }
    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 60;
    }
    function validSid(s) {
      return s is string && s.matches('^[0-9A-Za-z-]{3,20}$');
    }
    // الرقم الجامعي انحجز بنفس الدفعة لهي المجموعة
    function sidOk(s, gid) {
      return getAfter(/databases/$(database)/documents/sids/$(s)).data.g == gid;
    }
    function group(gid) {
      return getAfter(/databases/$(database)/documents/groups/$(gid)).data;
    }
    match /settings/{id} {
      allow get: if true;
      allow write: if isTeacher();
    }
    // المجموعة + أرقامها الجامعية (sids) + مقعدها (slots) بينكتبوا بدفعة وحدة (batch)، وكل وحدة بتتأكد من التانية.
    // التسجيل create بس: إذا الرمز أو الرقم الجامعي أو المقعد موجود، الكتابة بتصير update وبتنرفض.
    match /groups/{gid} {
      allow create: if regOpen()
        && gid.matches('^[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['algo', 'slot', 'size', 'n1', 's1', 'n2', 's2', 'n3', 's3', 'pin', 'at'])
        && request.resource.data.keys().hasAll(['algo', 'slot', 'size', 'n1', 's1', 'n2', 's2', 'n3', 's3', 'pin', 'at'])
        && request.resource.data.algo in ['sjf', 'srtf', 'rr', 'prio', 'pprio']
        && request.resource.data.slot is int && request.resource.data.slot >= 1 && request.resource.data.slot <= cfg().cap
        && validName(request.resource.data.n1) && validSid(request.resource.data.s1) && sidOk(request.resource.data.s1, gid)
        && validName(request.resource.data.n2) && validSid(request.resource.data.s2) && sidOk(request.resource.data.s2, gid)
        && request.resource.data.s1 != request.resource.data.s2
        && ((request.resource.data.size == 2 && request.resource.data.n3 == '' && request.resource.data.s3 == '')
          || (request.resource.data.size == 3 && validName(request.resource.data.n3) && validSid(request.resource.data.s3) && sidOk(request.resource.data.s3, gid)
            && request.resource.data.s3 != request.resource.data.s1 && request.resource.data.s3 != request.resource.data.s2))
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{6}$')
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.algo + '_' + string(request.resource.data.slot))).data.g == gid;
      allow read, write: if isTeacher();
    }
    // الرقم الجامعي المحجوز: get للكل (لحتى الصفحة تقول «مسجّل مسبقاً»)، بدون list (ما حدا بيقدر يجيب كل الأرقام)
    match /sids/{sid} {
      allow create: if regOpen()
        && request.resource.data.keys().hasOnly(['g', 'at'])
        && request.resource.data.g is string
        && request.resource.data.at == request.time
        && sid in [group(request.resource.data.g).s1, group(request.resource.data.g).s2, group(request.resource.data.g).s3];
      allow get: if true;
      allow read, write: if isTeacher();
    }
    // المقاعد: slots/{algo}_{n} و n ≤ cap. list للكل لحتى الصفحة تعدّ الأماكن الباقية (فيها رمز المجموعة بس، مش أسماء)
    match /slots/{slot} {
      allow create: if regOpen()
        && request.resource.data.keys().hasOnly(['g', 'algo'])
        && request.resource.data.g is string
        && group(request.resource.data.g).algo == request.resource.data.algo
        && slot == request.resource.data.algo + '_' + string(group(request.resource.data.g).slot);
      allow read: if true;
      allow write: if isTeacher();
    }
    // التسليم: بالرقم السري تبع المجموعة، وبيتعدّل لحتى الموعد. القراءة للمدرّس بس (لأن فيه الرقم السري)
    match /subs/{gid} {
      allow create, update: if subOpen()
        && request.resource.data.keys().hasOnly(['pin', 'url', 'kind', 'at'])
        && request.resource.data.pin == get(/databases/$(database)/documents/groups/$(gid)).data.pin
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.url.matches('^https?://[^ ]+[.][^ ]+$')
        && ((request.resource.data.kind == 'github' && request.resource.data.url.matches('^https://(www[.])?github[.]com/[^ ]+$'))
          || (request.resource.data.kind == 'link' && !request.resource.data.url.matches('^https://(www[.])?github[.]com/[^ ]+$')))
        && request.resource.data.at == request.time;
      allow read, delete: if isTeacher();
    }
  }
}
