---
// «قِس C بنفسك» (الجلسة 2): منقيس زمن تنفيذ حقيقي بمتصفح الطالب.
// المهمة: البحث عن رقم بقائمة فيها مليونين رقم (مرة بأولها، مرة بآخرها، ومرة مش موجود)،
// منشغّلها N مرة بـ performance.now() ومنرسم مدرّج تكراري مع المتوسط والأكبر.
// زر الحِمل بيشغّل Workers بتعجق الذاكرة والمعالج، فغالباً بيطول الذيل.
// الأرقام بتختلف من جهاز لجهاز، فما منكتب ولا رقم مقاس بالصفحة.
---

<div class="not-content wl-box rts-wcet" data-rts-wcet>
	<h4>قِس C بنفسك</h4>
	<p class="os-hint">
		سنشغّل في متصفحك مهمة حقيقية: <b>البحث عن رقم في قائمة فيها مليونا رقم</b>. مرة يكون الرقم في أول القائمة، ومرة في آخرها، ومرة غير موجود أصلاً. ونقيس زمن كل مرة بساعة المتصفح الدقيقة.
	</p>
	<div class="wl-row">
		<label class="wl-label">
			<span>عدد مرات التشغيل</span>
			<select class="wl-select" data-in="n">
				<option value="200" selected>200</option>
				<option value="1000">1000</option>
			</select>
		</label>
		<label class="ai-check"><input type="checkbox" data-in="load" /> أشغِل المعالج بشيء آخر أثناء القياس</label>
	</div>
	<div class="wl-row">
		<button type="button" class="wl-btn primary" data-start>▶ ابدأ القياس</button>
		<span class="wc-prog" data-out="prog"></span>
	</div>
	<div class="wc-progbar" aria-hidden="true"><div data-out="pbar"></div></div>
	<figure class="ai-chart wc-fig">
		<svg data-out="hist" role="img" aria-label="مدرّج تكراري لأزمنة التنفيذ المقيسة، مع خط المتوسط وخط أكبر زمن"></svg>
		<figcaption>المحور الأفقي: زمن المرة الواحدة (ms). وطول كل عمود: كم مرة جاء الزمن في هذا المجال. الخط المتقطع هو <b>المتوسط</b>، والأحمر هو <b>أكبر زمن رأيناه</b>. والأعمدة البرتقالية مرات أبطأ من المتوسط بمرة ونصف أو أكثر. والإطار المتقطع الرمادي هو القياس السابق، للمقارنة.</figcaption>
	</figure>
	<div class="wl-grid ai-metrics">
		<div class="wl-out"><span>عدد المرات</span><strong data-out="n">–</strong></div>
		<div class="wl-out"><span>الأقل</span><strong data-out="min">–</strong></div>
		<div class="wl-out"><span>المتوسط</span><strong data-out="mean">–</strong></div>
		<div class="wl-out"><span>الأكبر (أسوأ ما رأينا)</span><strong data-out="max">–</strong></div>
		<div class="wl-out"><span>مرات أطول من المتوسط</span><strong data-out="over">–</strong></div>
		<div class="wl-out"><span>C للتصميم (الأكبر + 20%)</span><strong data-out="design">–</strong></div>
	</div>
	<p class="wl-msg" data-out="msg"></p>
</div>

<style is:global>
	.rts-wcet .wc-prog { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.rts-wcet .wc-progbar { height: 6px; border-radius: 3px; background: var(--sl-color-black); overflow: hidden; direction: ltr; }
	.rts-wcet .wc-progbar div { height: 100%; width: 0; background: var(--sl-color-accent); transition: width 0.15s linear; }
	.rts-wcet .wc-fig svg { font-family: sans-serif; }
	.rts-wcet .wc-bar { fill: var(--sl-color-accent); opacity: 0.85; transition: height 0.2s ease-out, y 0.2s ease-out; }
	.rts-wcet .wc-bar.tail { fill: #f0a050; }
	.rts-wcet .wc-ghost { fill: none; stroke: var(--sl-color-gray-3); stroke-dasharray: 3 2; stroke-width: 1; }
	.rts-wcet .wc-axis { stroke: var(--sl-color-gray-4); stroke-width: 1; }
	.rts-wcet .wc-tick { fill: var(--sl-color-gray-3); font-size: 11px; }
	.rts-wcet .wc-mean { stroke: var(--sl-color-white); stroke-width: 2; stroke-dasharray: 5 4; }
	.rts-wcet .wc-max { stroke: #e5534b; stroke-width: 2.5; }
	.rts-wcet .wc-lbl { font-size: 12px; font-weight: 700; fill: var(--sl-color-white); }
	.rts-wcet .wc-lbl.red { fill: #e5534b; }
	.rts-wcet .wc-empty { fill: var(--sl-color-gray-3); font-size: 13px; }
</style>

<script>
	import { timeStats, histogram } from '../../scripts/rts';

	const SIZE = 2_000_000;
	const BINS = 24;
	const fmt = (x: number) => (x >= 10 ? x.toFixed(1) : x.toFixed(2));

	// شغل بالخلفية بخيوط تانية: بيعجق الذاكرة والمعالج متل برنامج تاني تقيل
	const WORKER_SRC = `
		const a = new Float64Array(1 << 22);
		let i = 0, s = 0;
		for (;;) { for (let k = 0; k < 1e6; k++) { i = (i * 1103515245 + 12345) & ((1 << 22) - 1); s += a[i]; a[i] = s % 7; } }
	`;

	document.querySelectorAll<HTMLElement>('[data-rts-wcet]').forEach((root) => {
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const inp = <T extends HTMLElement>(k: string) => root.querySelector<T>(`[data-in="${k}"]`)!;
		const btn = root.querySelector<HTMLButtonElement>('[data-start]')!;
		const svg = out('hist') as unknown as SVGSVGElement;
		let data: Int32Array | null = null;
		let prev: number[] = [];
		let cur: number[] = [];
		let sink = 0;

		// المهمة: بحث خطي عن رقم. مكانه بيقرر طول الشغل
		function task(target: number) {
			const a = data!;
			for (let i = 0; i < a.length; i++) if (a[i] === target) return i;
			return -1;
		}

		function draw() {
			const W = Math.max(300, Math.min(900, Math.round(svg.getBoundingClientRect().width) || 600));
			const H = 210;
			const L = 30;
			const R = 12;
			const TOP = 24;
			const BOT = 26;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			if (!cur.length && !prev.length) {
				svg.innerHTML = `<text class="wc-empty" x="${W / 2}" y="${H / 2}" text-anchor="middle" direction="rtl">اضغط «ابدأ القياس»</text>`;
				return;
			}
			const top = Math.max(...cur, ...prev, 0.01) * 1.08;
			const hc = histogram(cur, BINS, top);
			const hp = prev.length ? histogram(prev, BINS, top) : [];
			// منقارن بالنسبة (مش بالعدد) لأنه ممكن يختلف عدد المرات
			const share = (h: number[], n: number) => h.map((v) => (n ? v / n : 0));
			const sc = share(hc, cur.length);
			const sp = share(hp, prev.length);
			const peak = Math.max(...sc, ...sp, 0.01);
			const bw = (W - L - R) / BINS;
			const X = (t: number) => L + (t / top) * (W - L - R);
			const Y = (s: number) => H - BOT - (s / peak) * (H - BOT - TOP);
			const st = timeStats(cur);
			let g = `<line class="wc-axis" x1="${L}" x2="${W - R}" y1="${H - BOT}" y2="${H - BOT}"/>`;
			sc.forEach((s, i) => {
				if (!s) return;
				const x0 = L + i * bw;
				const tail = cur.length > 0 && x0 >= X(st.mean * 1.5);
				g += `<rect class="wc-bar${tail ? ' tail' : ''}" x="${x0 + 1}" y="${Y(s)}" width="${Math.max(1, bw - 2)}" height="${H - BOT - Y(s)}" rx="2"/>`;
			});
			sp.forEach((s, i) => {
				if (s) g += `<rect class="wc-ghost" x="${L + i * bw + 1}" y="${Y(s)}" width="${Math.max(1, bw - 2)}" height="${H - BOT - Y(s)}"/>`;
			});
			// تدريجات المحور بالـ ms
			const nice = [0.1, 0.2, 0.25, 0.5, 1, 2, 2.5, 5, 10, 20, 25, 50, 100, 200, 500].find((s) => top / s <= 6) ?? 1000;
			for (let t = 0; t <= top + 1e-9; t += nice) {
				g += `<line class="wc-axis" x1="${X(t)}" x2="${X(t)}" y1="${H - BOT}" y2="${H - BOT + 4}"/>`;
				g += `<text class="wc-tick" x="${X(t)}" y="${H - BOT + 16}" text-anchor="middle">${+t.toFixed(2)}</text>`;
			}
			g += `<text class="wc-tick" x="${W - R}" y="${H - 1}" text-anchor="end">ms</text>`;
			if (cur.length) {
				const xm = X(st.mean);
				const xx = X(st.max);
				g += `<line class="wc-mean" x1="${xm}" x2="${xm}" y1="${TOP - 6}" y2="${H - BOT}"/>`;
				g += `<line class="wc-max" x1="${xx}" x2="${xx}" y1="${TOP - 6}" y2="${H - BOT}"/>`;
				// الكتابة على يمين الخط إلا إذا ما في محل
				const near = Math.abs(xx - xm) < 70;
				g += `<text class="wc-lbl" x="${xm - 4}" y="${TOP - 10}" text-anchor="end" direction="rtl">المتوسط</text>`;
				g += `<text class="wc-lbl red" x="${xx + (xx > W - 60 ? -4 : 4)}" y="${near ? TOP + 6 : TOP - 10}" text-anchor="${xx > W - 60 ? 'end' : 'start'}" direction="rtl">الأكبر</text>`;
			}
			svg.innerHTML = g;
		}

		function report(done: boolean) {
			const st = timeStats(cur);
			if (!st.n) return;
			const over = cur.filter((x) => x > st.mean).length;
			out('n').textContent = `${st.n}`;
			out('min').textContent = `${fmt(st.min)} ms`;
			out('mean').textContent = `${fmt(st.mean)} ms`;
			out('max').textContent = `${fmt(st.max)} ms`;
			out('over').textContent = `${Math.round((over / st.n) * 100)}%`;
			out('design').textContent = `${fmt(st.max * 1.2)} ms`;
			if (!done) return;
			const m = out('msg');
			m.className = 'wl-msg';
			m.innerHTML =
				`لو كتبنا C = المتوسط (<bdi dir="ltr">${fmt(st.mean)} ms</bdi>)، لكانت <bdi dir="ltr">${Math.round((over / st.n) * 100)}%</bdi> من المرات أطول منه، أي أن المهلة قد تفوت في كل واحدة منها. ` +
				`لذلك نصمم بأسوأ زمن: أكبر ما رأيناه <bdi dir="ltr">${fmt(st.max)} ms</bdi>، أي أبطأ من المتوسط <bdi dir="ltr">${(st.max / st.mean).toFixed(1)}</bdi> مرة. ` +
				`لكن انتبه: هذا أسوأ ما <b>رأيناه</b> فقط، وقد يأتي يوم أسوأ منه، لذلك نضيف هامش أمان.`;
		}

		btn.addEventListener('click', () => {
			if (!data) {
				data = new Int32Array(SIZE);
				for (let i = 0; i < SIZE; i++) data[i] = i * 3 + 1; // أعداد فردية بالترتيب، فالرقم الزوجي «مش موجود»
			}
			const N = +inp<HTMLSelectElement>('n').value;
			const load = inp<HTMLInputElement>('load').checked;
			if (cur.length) prev = cur;
			cur = [];
			btn.disabled = true;
			inp<HTMLSelectElement>('n').disabled = true;
			inp<HTMLInputElement>('load').disabled = true;
			out('msg').textContent = '';
			const workers: Worker[] = [];
			if (load) {
				try {
					const url = URL.createObjectURL(new Blob([WORKER_SRC], { type: 'text/javascript' }));
					const k = Math.max(2, Math.min(8, navigator.hardwareConcurrency || 4));
					for (let i = 0; i < k; i++) workers.push(new Worker(url));
					URL.revokeObjectURL(url);
				} catch {
					/* بدون workers منكمّل بدون حِمل */
				}
			}

			const one = () => {
				// 15% غير موجود (أسوأ حالة)، والباقي بمكان عشوائي
				const target = Math.random() < 0.15 ? 2 : Math.floor(Math.random() * SIZE) * 3 + 1;
				const t0 = performance.now();
				sink += task(target);
				cur.push(performance.now() - t0);
			};

			// منقيس بدفعات قصيرة لحتى ما تعلق الصفحة، ومنرسم بعد كل دفعة
			const chunk = () => {
				const end = performance.now() + 40;
				while (cur.length < N && performance.now() < end) one();
				out('prog').textContent = `${cur.length} / ${N}`;
				out('pbar').style.width = `${(cur.length / N) * 100}%`;
				draw();
				report(false);
				if (cur.length < N) return void setTimeout(chunk, 0);
				workers.forEach((w) => w.terminate());
				btn.disabled = false;
				inp<HTMLSelectElement>('n').disabled = false;
				inp<HTMLInputElement>('load').disabled = false;
				btn.textContent = '▶ قِس مرة أخرى';
				out('prog').textContent = load ? 'انتهى (مع شغل في الخلفية)' : 'انتهى';
				report(true);
				if (sink === -42) console.log(sink); // لحتى ما يشيل المترجم الحلقة
			};
			// إذا في حِمل، منعطيه لحظة ليبلّش
			setTimeout(chunk, load ? 300 : 30);
		});

		draw();
		window.addEventListener('resize', draw);
	});
</script>
