---
// شريط إعلانات على مستوى الموقع: بيعرض آخر إعلان، والطالب بيقدر يسكره.
import { announcements } from '../data/announcements';

const { banner } = Astro.locals.starlightRoute.entry.data;
const latest = announcements[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = latest?.link ? `${base}/${latest.link}/` : `${base}/announcements/`;
const id = latest ? `${latest.date}-${latest.title}` : '';
---

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}
{
	!banner && latest && (
		<div class="site-banner" data-pagefind-ignore data-id={id} hidden>
			<span class="badge">جديد</span>
			<a href={href}>{latest.title}</a>
			<button type="button" aria-label="إخفاء الإعلان">×</button>
		</div>
	)
}

<script>
	const el = document.querySelector<HTMLElement>('.site-banner');
	if (el) {
		const key = 'dismissed-banner';
		let dismissed: string | null = null;
		try { dismissed = localStorage.getItem(key); } catch {}
		if (dismissed !== el.dataset.id) el.hidden = false;
		el.querySelector('button')?.addEventListener('click', () => {
			el.hidden = true;
			try { localStorage.setItem(key, el.dataset.id || ''); } catch {}
		});
	}
</script>

<style>
	.sl-banner,
	.site-banner {
		padding: 0.5rem var(--sl-nav-pad-x);
		background-color: var(--sl-color-accent);
		color: var(--sl-color-black);
		text-align: center;
		line-height: var(--sl-line-height-headings);
		font-size: var(--sl-text-sm);
	}
	.site-banner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		color: #fff;
		background: var(--banner-bg);
	}
	.site-banner[hidden] { display: none; }
	.site-banner a { color: #fff; font-weight: 500; }
	.badge {
		background: #fff;
		color: var(--cpu-green-dark);
		border-radius: 999px;
		padding: 0 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
	}
	button {
		background: none;
		border: 0;
		color: #fff;
		font-size: 1.25rem;
		cursor: pointer;
		line-height: 1;
		padding: 0 0.25rem;
	}
</style>
