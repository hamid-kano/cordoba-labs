---
// مشروع المادة: التسجيل بمجموعات، وبيانات المجموعة، والتسليم. المنطق والـ Firestore بـ src/scripts/projects.ts.
// course: os1 | rts. part: status (حالة المواعيد) | register (التسجيل) | data (بيانات مجموعتي) | submit (التسليم).
// كل الأجزاء بالصفحة بيشتغلوا بسكربت واحد، وبيقروا الإعدادات من Firestore (مش موجودة = مقفول).
import { COURSES, type Course } from '../scripts/projects';
interface Props { course: Course; part: 'status' | 'register' | 'data' | 'submit' }
const { course, part } = Astro.props;
const cp = COURSES[course];
const sizes = [1, 2, 3].filter((n) => n >= cp.minSize && n <= cp.maxSize);
const sizeLabel = (n: number) => (n === 1 ? 'طالب واحد' : n === 2 ? 'طالبان' : `${n} طلاب`);
const optHint = course === 'os1' ? 'اختاروا خوارزمية (إضافة إلى FCFS التي تنفّذها كل المجموعات):' : 'اختاروا مشروعاً:';
---

{part === 'status' && (
	<div class="not-content wl-box pj-status" data-pj="status" data-course={course}>
		<div class="wl-grid">
			<div class="wl-out"><span>التسجيل</span><strong data-pj-out="reg">…</strong><small data-pj-out="regWhen"></small></div>
			<div class="wl-out"><span>التسليم</span><strong data-pj-out="sub">…</strong><small data-pj-out="subWhen"></small></div>
		</div>
	</div>
)}

{part === 'register' && (
	<form class="not-content wl-box pj-reg" data-pj="register" data-course={course} autocomplete="off">
		<h4>📝 تسجيل مجموعة</h4>
		<p class="wl-msg" data-pj-out="regMsg"></p>
		<fieldset data-pj-fields disabled>
			<div class="wl-row" role="group" aria-label="عدد أفراد المجموعة">
				<span>عدد أفراد المجموعة:</span>
				{sizes.map((n) => (
					<button type="button" class="wl-btn" data-size={n} aria-pressed={String(n === cp.maxSize)}>{sizeLabel(n)}</button>
				))}
			</div>
			{[1, 2, 3].map((i) => (
				<div class="pj-member" data-member={i}>
					<label>اسم الطالب {i} الكامل<input class="wl-input pj-name" name={`n${i}`} maxlength="60" /></label>
					<label>الرقم الجامعي<input class="wl-input" name={`s${i}`} inputmode="numeric" maxlength="20" /></label>
				</div>
			))}
			<p>{optHint}</p>
			<div class="pj-algos">
				{cp.opts.map((a) => (
					<label class="pj-algo">
						<input type="radio" name="opt" value={a} />
						<span><b>{cp.optName[a]}</b><small data-seats={a}>…</small></span>
					</label>
				))}
			</div>
			<label class="pj-check"><input type="checkbox" name="ok" /> تأكدنا من صحة الأسماء والأرقام الجامعية، ونعرف أن التعديل بعد التسجيل يكون عن طريق المدرّس فقط.</label>
			<button type="submit" class="wl-btn primary">سجّل المجموعة</button>
		</fieldset>
		<div class="pj-done" data-pj-out="done" hidden></div>
	</form>
)}

{part === 'data' && (
	<div class="not-content wl-box pj-data" data-pj="data" data-course={course}>
		<h4>📄 بيانات مجموعتي</h4>
		<div class="wl-row">
			<label>رمز المجموعة <input class="wl-input pj-code" data-pj-in="code" maxlength="6" placeholder="مثلاً K7M2" /></label>
			<button type="button" class="wl-btn primary" data-pj-act="show">اعرض البيانات</button>
		</div>
		<p class="wl-msg" data-pj-out="dataMsg"></p>
		<div data-pj-out="dataBox" hidden></div>
	</div>
)}

{part === 'submit' && (
	<form class="not-content wl-box pj-sub" data-pj="submit" data-course={course} autocomplete="off">
		<h4>📤 تسليم المشروع</h4>
		<p class="wl-msg" data-pj-out="subMsg"></p>
		<fieldset data-pj-fields disabled>
			<div class="pj-member">
				<label>رمز المجموعة<input class="wl-input pj-code" name="gid" maxlength="6" /></label>
				<label>الرقم السري (6 أرقام)<input class="wl-input" name="pin" inputmode="numeric" maxlength="6" /></label>
			</div>
			<label class="pj-url">رابط المشروع (GitHub أو أي رابط آخر)<input class="wl-input" name="url" type="url" maxlength="300" placeholder="https://github.com/..." /></label>
			<p class="se-note" data-pj-out="kind"></p>
			<button type="submit" class="wl-btn primary">سلّم</button>
		</fieldset>
		<p class="se-note" data-pj-out="last"></p>
	</form>
)}

<style is:global>
	.pj-status .wl-out small { display: block; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); margin-top: 0.2rem; }
	.pj-reg fieldset, .pj-sub fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
	.pj-reg fieldset:disabled, .pj-sub fieldset:disabled { opacity: 0.5; }
	.pj-member { display: grid; grid-template-columns: 2fr 1fr; gap: 0.5rem; }
	@media (max-width: 40rem) { .pj-member { grid-template-columns: 1fr; padding-bottom: 0.5rem; border-bottom: 1px dashed var(--sl-color-gray-5); } }
	.pj-member label, .pj-url, .pj-data label { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--sl-text-sm); }
	.pj-name { direction: rtl; }
	.pj-code { text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; max-width: 9rem; }
	.pj-algos { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.5rem; }
	.pj-algo { display: flex; gap: 0.5rem; align-items: center; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 0.5rem 0.6rem; cursor: pointer; }
	.pj-algo:has(input:checked) { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
	.pj-algo:has(input:disabled) { opacity: 0.45; cursor: not-allowed; }
	.pj-algo span { display: flex; flex-direction: column; }
	.pj-algo small { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.pj-check { display: flex; gap: 0.5rem; align-items: flex-start; font-size: var(--sl-text-sm); }
	.pj-check input { margin-top: 0.3rem; }
	.pj-done { border: 2px solid var(--sl-color-accent); border-radius: 0.6rem; padding: 0.9rem; }
	.pj-secret { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.6rem 0; }
	.pj-secret div { flex: 1 1 9rem; text-align: center; background: var(--sl-color-gray-6); border-radius: 0.5rem; padding: 0.5rem; }
	.pj-secret strong { display: block; font-size: 1.8rem; letter-spacing: 0.2em; direction: ltr; color: var(--sl-color-white); font-family: var(--sl-font-mono); }
	.pj-file { direction: ltr; text-align: left; white-space: pre; font-family: var(--sl-font-mono); font-size: var(--sl-text-sm); background: var(--sl-color-gray-6); border-radius: 0.4rem; padding: 0.6rem 0.8rem; overflow-x: auto; }
</style>

<script>
	import { getFirestore, doc, getDoc, getDocs, collection, writeBatch, setDoc, serverTimestamp, Timestamp } from 'firebase/firestore/lite';
	import { app } from '../scripts/quizStore';
	import { firebaseReady } from '../data/firebase-config';
	import {
		COURSES, CLOSED, DEFAULT_CAP, regState, subState, newCode, newPin, CODE_RE, normCode, normSid, SID_RE, URL_RE, normUrl, linkKind,
		fmtWhen, left, loadLocal, saveLocal, os1Data, os1Input, rtsData, rtsWokwi, RTS_TASKS, type Course, type ProjSettings, type Mode,
	} from '../scripts/projects';

	const first = document.querySelector<HTMLElement>('[data-pj][data-course]');
	if (first) init(first.dataset.course as Course);

	function init(course: Course) {
		const cp = COURSES[course];
		const db = firebaseReady() ? getFirestore(app()) : null;
		const P = ['proj', course] as const;
		const q = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
		const out = (k: string) => q<HTMLElement>(`[data-pj-out="${k}"]`);
		const say = (k: string, t: string, cls = '') => { const m = out(k); if (m) { m.className = 'wl-msg' + (cls ? ' ' + cls : ''); m.textContent = t; } };
		const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
		const local = loadLocal(course);
		let settings: ProjSettings = CLOSED;
		let slots: { id: string; g: string; opt: string }[] = [];

		const toDate = (v: unknown) => (v instanceof Timestamp ? v.toDate() : null);
		const mode = (v: unknown): Mode => (v === 'open' || v === 'auto' ? v : 'closed');
		async function loadSettings() {
			if (!db) return;
			try {
				const s = await getDoc(doc(db, ...P));
				if (!s.exists()) return;
				const x = s.data();
				settings = { regFrom: toDate(x.regFrom), regTo: toDate(x.regTo), subTo: toDate(x.subTo), regMode: mode(x.regMode), subMode: mode(x.subMode), cap: typeof x.cap === 'number' ? x.cap : DEFAULT_CAP };
			} catch (e) { console.warn('project settings', e); }
		}
		async function loadSlots() {
			if (!db) return;
			const snap = await getDocs(collection(db, ...P, 'slots'));
			slots = snap.docs.map((d) => ({ id: d.id, g: String(d.data().g), opt: String(d.data().opt) }));
		}

		// ===== الحالة =====
		function renderStatus() {
			const r = regState(settings), s = subState(settings);
			const set = (k: string, t: string) => { const e = out(k); if (e) e.textContent = t; };
			set('reg', r.open ? 'مفتوح' : r.soon ? 'لم يبدأ بعد' : 'مغلق');
			set('regWhen', r.open && r.until ? `يُغلق ${fmtWhen(r.until)} (بعد ${left(r.until)})` : r.soon ? `يُفتح ${fmtWhen(r.soon)}` : r.open ? '' : settings.regTo && settings.regMode === 'auto' ? `أُغلق ${fmtWhen(settings.regTo)}` : '');
			set('sub', s.open ? 'مفتوح' : 'مغلق');
			set('subWhen', s.open && s.until ? `آخر موعد ${fmtWhen(s.until)} (بعد ${left(s.until)})` : !s.open && settings.subTo && settings.subMode === 'auto' ? `انتهى ${fmtWhen(settings.subTo)}` : '');
		}

		// ===== التسجيل =====
		const reg = q<HTMLFormElement>('[data-pj="register"]');
		let size = cp.maxSize;
		function setSize(n: number) {
			size = n;
			reg?.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.size) === n)));
			reg?.querySelectorAll<HTMLElement>('[data-member]').forEach((m) => (m.hidden = Number(m.dataset.member) > n));
		}
		function renderSeats() {
			if (!reg) return;
			for (const a of cp.opts) {
				const used = slots.filter((s) => s.opt === a).length;
				const rest = Math.max(0, settings.cap - used);
				const el = q<HTMLElement>(`[data-seats="${a}"]`, reg);
				if (el) el.textContent = rest ? `باقي ${rest} من ${settings.cap}` : 'اكتمل العدد';
				const input = q<HTMLInputElement>(`input[value="${a}"]`, reg)!;
				input.disabled = !rest;
				if (!rest) input.checked = false;
			}
		}
		function showDone(gid: string, pin: string, opt: string, names: string[]) {
			const box = out('done')!;
			box.hidden = false;
			const extra = course === 'os1' ? ' (مع FCFS)' : '';
			box.innerHTML = `<b>✓ تم تسجيل مجموعتكم: ${names.map(esc).join('، ')}</b><p>${cp.optWord}: <b>${cp.optName[opt] ?? opt}</b>${extra}.</p>
				<div class="pj-secret"><div>رمز المجموعة<strong>${gid}</strong></div><div>الرقم السري<strong>${pin}</strong></div></div>
				<p>⚠️ <b>صوّروا هذه الشاشة وأرسلوها لكل أعضاء المجموعة.</b> الرمز يعرض بياناتكم، والرقم السري تحتاجونه عند التسليم. لا تعطوا الرقم السري لأحد خارج المجموعة.</p>
				<p class="se-note">إذا ضاع الرقم السري، راجعوا المدرّس.</p>`;
		}
		async function initRegister() {
			if (!reg) return;
			reg.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) => b.addEventListener('click', () => setSize(Number(b.dataset.size))));
			setSize(cp.maxSize);
			if (local) showDone(local.gid, local.pin, local.opt, local.names);
			if (!db) return say('regMsg', 'التسجيل غير متاح حالياً.', 'wl-bad');
			try { await loadSlots(); } catch (e) { console.warn(e); }
			renderSeats();
			const r = regState(settings);
			const fields = q<HTMLFieldSetElement>('[data-pj-fields]', reg)!;
			fields.disabled = !r.open;
			if (!r.open) say('regMsg', r.soon ? `التسجيل لم يبدأ بعد، ويُفتح ${fmtWhen(r.soon)}.` : 'التسجيل مغلق حالياً.', 'wl-bad');
			else if (local) say('regMsg', 'هذا الجهاز سجّل مجموعة مسبقاً (بياناتها في الأسفل). لا تسجّلوا المجموعة مرتين.');
			reg.addEventListener('submit', (ev) => { ev.preventDefault(); register(fields); });
		}
		async function register(fields: HTMLFieldSetElement) {
			if (!db || !reg) return;
			const fd = new FormData(reg);
			const members: { n: string; s: string }[] = [];
			for (let i = 1; i <= size; i++) {
				const n = String(fd.get(`n${i}`) ?? '').trim().replace(/\s+/g, ' ');
				const s = normSid(String(fd.get(`s${i}`) ?? ''));
				if (n.split(' ').length < 2 || n.length < 5) return say('regMsg', `اكتب الاسم الكامل للطالب ${i} (الاسم والكنية على الأقل).`, 'wl-bad');
				if (!SID_RE.test(s)) return say('regMsg', `الرقم الجامعي للطالب ${i} غير صحيح.`, 'wl-bad');
				members.push({ n, s });
			}
			if (new Set(members.map((m) => m.s)).size !== members.length) return say('regMsg', 'الرقم الجامعي نفسه مكتوب مرتين.', 'wl-bad');
			const opt = fd.get('opt') as string | null;
			if (!opt) return say('regMsg', course === 'os1' ? 'اختاروا خوارزمية.' : 'اختاروا مشروعاً.', 'wl-bad');
			if (!fd.get('ok')) return say('regMsg', 'أكّدوا صحة الأسماء والأرقام أولاً.', 'wl-bad');
			fields.disabled = true;
			say('regMsg', 'جارٍ التسجيل...');
			try {
				// رقم مسجّل بمجموعة تانية؟ (sids مسموح قراءته واحد واحد)
				for (const m of members) {
					if ((await getDoc(doc(db, ...P, 'sids', m.s))).exists()) {
						fields.disabled = false;
						return say('regMsg', `الرقم الجامعي ${m.s} مسجّل في مجموعة أخرى. إذا كان هذا خطأ، راجعوا المدرّس.`, 'wl-bad');
					}
				}
				// أول مقعد فاضي بالخيار؛ وإذا حدا سبقنا عليه (أو انصدف رمز مكرر) منعيد المحاولة
				for (let attempt = 0; attempt < 4; attempt++) {
					await loadSlots();
					renderSeats();
					const taken = new Set(slots.filter((s) => s.opt === opt).map((s) => s.id));
					let slot = 0;
					for (let n = 1; n <= settings.cap; n++) if (!taken.has(`${opt}_${n}`)) { slot = n; break; }
					if (!slot) { fields.disabled = false; return say('regMsg', `اكتمل العدد في «${cp.optName[opt]}». اختاروا غيره.`, 'wl-bad'); }
					const gid = newCode(), pin = newPin();
					const get = (i: number, k: 'n' | 's') => members[i]?.[k] ?? '';
					const b = writeBatch(db);
					b.set(doc(db, ...P, 'groups', gid), { opt, slot, size, n1: get(0, 'n'), s1: get(0, 's'), n2: get(1, 'n'), s2: get(1, 's'), n3: get(2, 'n'), s3: get(2, 's'), pin, at: serverTimestamp() });
					for (const m of members) b.set(doc(db, ...P, 'sids', m.s), { g: gid, at: serverTimestamp() });
					b.set(doc(db, ...P, 'slots', `${opt}_${slot}`), { g: gid, opt });
					try {
						await b.commit();
					} catch (e) {
						console.warn('register attempt failed', e);
						continue;
					}
					const names = members.map((m) => m.n);
					saveLocal(course, { gid, pin, opt, names });
					say('regMsg', '');
					q<HTMLElement>('[data-pj-fields]', reg)!.hidden = true;
					showDone(gid, pin, opt, names);
					slots.push({ id: `${opt}_${slot}`, g: gid, opt });
					const codeIn = q<HTMLInputElement>('[data-pj-in="code"]');
					if (codeIn) { codeIn.value = gid; showData(); }
					fillSubmit(gid, pin);
					return;
				}
				throw new Error('all attempts failed');
			} catch (e) {
				console.warn(e);
				fields.disabled = false;
				await loadSettings();
				say('regMsg', regState(settings).open ? 'تعذّر التسجيل. تأكدوا أن الأرقام الجامعية غير مسجّلة مسبقاً، ثم أعيدوا المحاولة.' : 'التسجيل مغلق الآن.', 'wl-bad');
			}
		}

		// ===== بيانات المجموعة =====
		function download(name: string, text: string) {
			const a = document.createElement('a');
			a.href = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
			a.download = name;
			a.click();
			URL.revokeObjectURL(a.href);
		}
		function os1Box(gid: string, opt: string) {
			const { procs, q: quantum } = os1Data(gid);
			return `<p>الخوارزميتان: <b>FCFS</b> و<b>${cp.optName[opt]}</b>${opt === 'rr' ? `، والشريحة <b>q = ${quantum}</b>` : ''}.</p>
				<div class="wl-scroll"><table class="wl-table"><thead><tr><th>العملية</th><th>زمن الوصول</th><th>زمن التنفيذ</th><th>الأولوية</th></tr></thead><tbody>
				${procs.map((p) => `<tr><td>${p.name}</td><td>${p.arrival}</td><td>${p.burst}</td><td>${p.prio}</td></tr>`).join('')}</tbody></table></div>
				<p class="se-note">الأولوية: الرقم الأصغر هو الأهم.${opt === 'prio' || opt === 'pprio' ? '' : ' (عمود الأولوية لا تحتاجه خوارزميتكم، لكنه جزء من صيغة الملف.)'}</p>
				<p>ملف الإدخال <code>input.txt</code>:</p><pre class="pj-file">${esc(os1Input(gid, opt))}</pre>
				<button type="button" class="wl-btn" data-pj-act="download">⬇ نزّل input.txt</button>`;
		}
		function rtsBox(gid: string, opt: string) {
			const ts = rtsData(gid), names = RTS_TASKS[opt];
			return `<p>المشروع: <b>${cp.optName[opt]}</b>. المهلة = الدور (D = T)، والأزمنة بالميلي ثانية.</p>
				<div class="wl-scroll"><table class="wl-table"><thead><tr><th>المهمة</th><th>ماذا تفعل؟</th><th>C</th><th>T</th></tr></thead><tbody>
				${ts.map((t, i) => `<tr><td>${names[i].ar}</td><td>${names[i].job}</td><td>${t.C}</td><td>${t.T}</td></tr>`).join('')}</tbody></table></div>
				<p>أسطر جدول <code>tasks</code> لقالب Wokwi. مكان <code>?</code> ضعوا الأولوية التي اخترتموها:</p><pre class="pj-file">${esc(rtsWokwi(gid, opt))}</pre>
				<button type="button" class="wl-btn" data-pj-act="download">⬇ نزّل tasks.txt</button>`;
		}
		const dataBox = q<HTMLElement>('[data-pj="data"]');
		async function showData() {
			if (!dataBox) return;
			const input = q<HTMLInputElement>('[data-pj-in="code"]', dataBox)!;
			const gid = normCode(input.value);
			input.value = gid;
			const box = out('dataBox')!;
			box.hidden = true;
			if (!CODE_RE.test(gid)) return say('dataMsg', 'رمز المجموعة 4 أحرف وأرقام، مثل K7M2.', 'wl-bad');
			if (!db) return say('dataMsg', 'غير متاح حالياً.', 'wl-bad');
			say('dataMsg', 'جارٍ البحث...');
			try {
				if (!slots.some((s) => s.g === gid)) await loadSlots();
			} catch (e) { console.warn(e); }
			const s = slots.find((x) => x.g === gid);
			if (!s) return say('dataMsg', 'لا توجد مجموعة بهذا الرمز.', 'wl-bad');
			say('dataMsg', '');
			box.hidden = false;
			box.innerHTML = course === 'os1' ? os1Box(gid, s.opt) : rtsBox(gid, s.opt);
			box.querySelector('[data-pj-act="download"]')!.addEventListener('click', () =>
				course === 'os1' ? download('input.txt', os1Input(gid, s.opt)) : download('tasks.txt', rtsWokwi(gid, s.opt) + '\n'),
			);
		}
		function initData() {
			if (!dataBox) return;
			const input = q<HTMLInputElement>('[data-pj-in="code"]', dataBox)!;
			q('[data-pj-act="show"]', dataBox)!.addEventListener('click', showData);
			input.addEventListener('keydown', (e) => { if (e.key === 'Enter') showData(); });
			if (local) { input.value = local.gid; showData(); }
		}

		// ===== التسليم =====
		const sub = q<HTMLFormElement>('[data-pj="submit"]');
		function fillSubmit(gid: string, pin: string) {
			if (!sub) return;
			(sub.elements.namedItem('gid') as HTMLInputElement).value = gid;
			(sub.elements.namedItem('pin') as HTMLInputElement).value = pin;
		}
		function showKind() {
			if (!sub) return;
			const url = normUrl((sub.elements.namedItem('url') as HTMLInputElement).value);
			const k = out('kind')!;
			k.textContent = !url ? 'التسليم عبر GitHub: علامتان. عبر أي رابط آخر (Google Drive مثلاً): علامة واحدة. والتسليم اليدوي (فلاشة مثلاً): صفر من هاتين العلامتين.'
				: !URL_RE.test(url) ? 'الرابط غير صحيح: يجب أن يبدأ بـ https://'
				: linkKind(url) === 'github' ? '✓ رابط GitHub: علامتا التسليم كاملتان (2 من 2).' : 'رابط غير GitHub: علامة واحدة من علامتي التسليم (1 من 2).';
		}
		function showLast() {
			const l = loadLocal(course);
			const e = out('last');
			if (e) e.textContent = l?.url && l.subAt ? `آخر تسليم من هذا الجهاز: ${l.url} (${fmtWhen(new Date(l.subAt))}). يمكنكم تعديله حتى الموعد، والمعتمد هو آخر تسليم.` : '';
		}
		function initSubmit() {
			if (!sub) return;
			if (local) fillSubmit(local.gid, local.pin);
			(sub.elements.namedItem('url') as HTMLInputElement).addEventListener('input', showKind);
			showKind();
			showLast();
			const fields = q<HTMLFieldSetElement>('[data-pj-fields]', sub)!;
			if (!db) return say('subMsg', 'التسليم غير متاح حالياً.', 'wl-bad');
			const s = subState(settings);
			fields.disabled = !s.open;
			if (!s.open) say('subMsg', 'التسليم مغلق حالياً.', 'wl-bad');
			sub.addEventListener('submit', async (ev) => {
				ev.preventDefault();
				const fd = new FormData(sub);
				const gid = normCode(String(fd.get('gid') ?? ''));
				const pin = normSid(String(fd.get('pin') ?? ''));
				const url = normUrl(String(fd.get('url') ?? ''));
				if (!CODE_RE.test(gid)) return say('subMsg', 'رمز المجموعة غير صحيح.', 'wl-bad');
				if (!/^[0-9]{6}$/.test(pin)) return say('subMsg', 'الرقم السري 6 أرقام.', 'wl-bad');
				if (!URL_RE.test(url) || url.length > 300) return say('subMsg', 'الرابط غير صحيح: يجب أن يبدأ بـ https://', 'wl-bad');
				fields.disabled = true;
				say('subMsg', 'جارٍ التسليم...');
				try {
					const kind = linkKind(url);
					await setDoc(doc(db, ...P, 'subs', gid), { pin, url, kind, at: serverTimestamp() });
					const l = loadLocal(course);
					if (l && l.gid === gid) saveLocal(course, { ...l, url, subAt: Date.now() });
					else saveLocal(course, { gid, pin, opt: slots.find((x) => x.g === gid)?.opt ?? '', names: [], url, subAt: Date.now() });
					say('subMsg', `✓ تم التسليم (${kind === 'github' ? 'GitHub: علامتان' : 'رابط آخر: علامة واحدة'}). يمكنكم تعديل الرابط حتى الموعد.`, 'wl-good');
					showLast();
				} catch (e) {
					console.warn(e);
					await loadSettings();
					say('subMsg', subState(settings).open ? 'تعذّر التسليم: تأكدوا من رمز المجموعة والرقم السري.' : 'التسليم مغلق الآن.', 'wl-bad');
				}
				fields.disabled = !subState(settings).open;
			});
		}

		(async () => {
			await loadSettings();
			renderStatus();
			setInterval(renderStatus, 60000);
			await initRegister();
			initData();
			initSubmit();
		})();
	}
</script>
