---
// هرم الاختبار: كتير اختبارات وحدة سريعة تحت، وقليل اختبارات قبول بطيئة فوق.
const levels = [
	{ t: 'اختبار القبول', s: 'الزبون يجرّب ويقرر', w: 150 },
	{ t: 'اختبار النظام', s: 'البرنامج كاملاً', w: 290 },
	{ t: 'اختبار التكامل', s: 'هل تعمل الأجزاء معاً؟', w: 430 },
	{ t: 'اختبار الوحدة', s: 'كل دالة وحدها', w: 570 },
];
const H = 62;
---

<figure class="wl-fig">
	<svg class="d-big" viewBox="0 0 640 290" role="img" aria-label="هرم الاختبار من الأسفل إلى الأعلى: اختبار الوحدة وهو الأكثر عدداً والأسرع، ثم التكامل، ثم النظام، ثم القبول وهو الأقل عدداً والأبطأ">
		{levels.map((l, i) => {
			const y = 14 + i * (H + 4), x = 320 - l.w / 2;
			return (
				<g>
					<rect x={x} y={y} width={l.w} height={H} rx="6" class="d-box" style={`opacity:${0.55 + i * 0.15}`}></rect>
					<text x="320" y={y + 27} class="d-t d-b">{l.t}</text>
					<text x="320" y={y + 50} class="d-s">{l.s}</text>
				</g>
			);
		})}
	</svg>
	<figcaption>
		كلما نزلنا في الهرم: اختبارات <strong>أكثر</strong> و<strong>أسرع</strong> و<strong>أرخص</strong>. وكلما صعدنا: أقل وأبطأ، لكنها أقرب إلى ما يراه الزبون.
	</figcaption>
</figure>
