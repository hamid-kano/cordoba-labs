---
// معمارية الشبكة: ند لند مقابل زبون/مخدم
const p2p = [
	{ x: 160, y: 60 },
	{ x: 60, y: 210 },
	{ x: 260, y: 210 },
];
const clients = [
	{ x: 400, y: 70 },
	{ x: 600, y: 70 },
	{ x: 400, y: 230 },
	{ x: 600, y: 230 },
];
---

<figure class="wl-fig">
	<svg viewBox="0 0 660 290" role="img" aria-label="يمين: كل جهاز موصول بالجميع. يسار: كل الأجهزة موصولة بخادم في الوسط">
		<!-- ند لند -->
		{p2p.map((a, i) => p2p.slice(i + 1).map((b) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="d-line d-blue" />))}
		{
			p2p.map((p) => (
				<g>
					<rect x={p.x - 40} y={p.y - 22} width="80" height="44" rx="8" class="d-box2" />
					<text x={p.x} y={p.y + 5} class="d-t">جهاز</text>
				</g>
			))
		}
		<text x="160" y="275" class="d-t d-b">ند لند (Peer to Peer)</text>

		<line x1="330" y1="20" x2="330" y2="270" class="d-line d-dash" />

		<!-- زبون/مخدم -->
		{clients.map((c) => <line x1="500" y1="150" x2={c.x} y2={c.y} class="d-line d-green" />)}
		<rect x="450" y="124" width="100" height="52" rx="8" class="d-box" />
		<text x="500" y="156" class="d-t d-b">الخادم</text>
		{
			clients.map((c) => (
				<g>
					<rect x={c.x - 40} y={c.y - 22} width="80" height="44" rx="8" class="d-box2" />
					<text x={c.x} y={c.y + 5} class="d-t">زبون</text>
				</g>
			))
		}
		<text x="500" y="275" class="d-t d-b">زبون/خادم (Client/Server)</text>
	</svg>
	<figcaption>في «ند لند» يتواصل كل جهاز مع الجميع ويدير نفسه. وفي «زبون/خادم» يوجد جهاز رئيسي (الخادم) يدير الشبكة ويحميها.</figcaption>
</figure>
