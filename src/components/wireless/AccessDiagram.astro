---
// تقنيات النفاذ المتعدد على شبكة (الزمن × التردد)
const C = ['#3a9ec2', '#e0a030', '#2fb36b', '#c0504d'];
const pw = 150, ph = 120, top = 30;
const panels = [
	{ k: 'FDMA', ar: 'لكل واحد تردد', ex: 'مثل غرف منفصلة' },
	{ k: 'TDMA', ar: 'لكل واحد دوره', ex: 'مثل الدور في الطابور' },
	{ k: 'CDMA', ar: 'لكل واحد رمزه', ex: 'مثل لغات مختلفة' },
	{ k: 'OFDMA', ar: 'لكل واحد خانات', ex: 'مثل مقاعد موزعة' },
];
const ofdma = [0, 2, 1, 3, 2, 0, 3, 1, 1, 3, 0, 2, 3, 1, 2, 0];
---

<figure class="wl-fig">
	<svg viewBox="0 0 660 230" role="img" aria-label="أربع طرق ليتشارك 4 مستخدمين القناة نفسها: بالتردد، بالزمن، بالرمز، وبخانات صغيرة">
		{
			panels.map((p, i) => {
				const x0 = 10 + i * 165;
				return (
					<g>
						<text x={x0 + pw / 2} y="18" class="d-t d-b d-ltr">{p.k}</text>
						<rect x={x0} y={top} width={pw} height={ph} class="d-box2" />
						{p.k === 'FDMA' && C.map((c, j) => <rect x={x0 + 4} y={top + 4 + j * 29} width={pw - 8} height="24" rx="3" fill={c} />)}
						{p.k === 'TDMA' && C.map((c, j) => <rect x={x0 + 4 + j * 36} y={top + 4} width="32" height={ph - 8} rx="3" fill={c} />)}
						{p.k === 'CDMA' && C.map((c, j) => <rect x={x0 + 4 + j * 5} y={top + 4 + j * 5} width={pw - 24} height={ph - 24} rx="3" fill={c} opacity="0.55" />)}
						{p.k === 'OFDMA' && ofdma.map((u, j) => <rect x={x0 + 4 + (j % 4) * 36} y={top + 4 + Math.floor(j / 4) * 29} width="32" height="24" rx="3" fill={C[u]} />)}
						<text x={x0 + pw / 2} y={top + ph + 22} class="d-t d-b">{p.ar}</text>
						<text x={x0 + pw / 2} y={top + ph + 42} class="d-s">{p.ex}</text>
					</g>
				);
			})
		}
	</svg>
	<figcaption>كل لون مستخدم. المربع هو القناة: الأفقي <strong>الزمن</strong> والعمودي <strong>التردد</strong>. وكل تقنية تقسم المربع بطريقة مختلفة حتى لا يتداخل المستخدمون.</figcaption>
</figure>
