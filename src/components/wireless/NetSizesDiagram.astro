---
// أنواع الشبكات حسب الحجم: دوائر متداخلة
const rings = [
	{ r: 60, name: 'PAN', ar: 'شخصية', ex: 'هاتف + سماعة', cls: 'd-fgreen' },
	{ r: 110, name: 'LAN', ar: 'محلية', ex: 'منزل، مختبر، شركة', cls: 'd-fblue' },
	{ r: 160, name: 'MAN', ar: 'مدينة', ex: 'فروع مصرف في مدينة', cls: 'd-forange' },
	{ r: 210, name: 'WAN', ar: 'واسعة', ex: 'بين الدول، والإنترنت', cls: 'd-fred' },
];
---

<figure class="wl-fig">
	<svg viewBox="0 0 640 300" role="img" aria-label="أنواع الشبكات حسب الحجم: PAN داخل LAN داخل MAN داخل WAN">
		{
			[...rings].reverse().map((g) => (
				<circle cx="250" cy="290" r={g.r * 1.3} class={g.cls} opacity="0.22" />
			))
		}
		{
			rings.map((g, i) => (
				<g>
					<text x="250" y={290 - g.r * 1.3 + 26} class="d-t d-b d-ltr">{g.name}</text>
					<line x1={250 + g.r * 0.45} y1={290 - g.r * 1.3 + 20} x2="455" y2={60 + (3 - i) * 62} class="d-line d-dash" />
					<text x="465" y={56 + (3 - i) * 62} class="d-t d-b d-end">{`${g.name}: ${g.ar}`}</text>
					<text x="465" y={76 + (3 - i) * 62} class="d-s d-end">{g.ex}</text>
				</g>
			))
		}
	</svg>
	<figcaption>كل شبكة أكبر تحتوي الأصغر منها: الشخصية داخل المحلية، والمحلية داخل شبكة المدينة، وكلها موصولة بالشبكة الواسعة.</figcaption>
</figure>
