---
// TCP (مع إشعار استلام) مقابل UDP (بدون إشعار)
const tcp = [
	{ y: 70, dir: 1, t: 'قطعة 1' },
	{ y: 110, dir: -1, t: 'ACK ✔' },
	{ y: 150, dir: 1, t: 'قطعة 2' },
	{ y: 190, dir: -1, t: 'ACK ✔' },
];
const udp = [
	{ y: 70, t: 'رزمة 1' },
	{ y: 105, t: 'رزمة 2' },
	{ y: 140, t: 'رزمة 3' },
	{ y: 175, t: 'رزمة 4' },
];
---

<figure class="wl-fig">
	<svg viewBox="0 0 660 260" role="img" aria-label="TCP: بعد كل قطعة يوجد إشعار استلام. UDP: تُرسل الرزم متتالية بدون إشعار">
		<defs>
			<marker id="tu-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="d-arrow" />
			</marker>
		</defs>
		<!-- TCP -->
		<text x="165" y="22" class="d-t d-b d-ltr">TCP</text>
		<text x="60" y="48" class="d-s">المرسل</text>
		<text x="270" y="48" class="d-s">المستقبل</text>
		<line x1="60" y1="55" x2="60" y2="215" class="d-line" />
		<line x1="270" y1="55" x2="270" y2="215" class="d-line" />
		{
			tcp.map((m) => (
				<g>
					<line x1={m.dir > 0 ? 60 : 270} y1={m.y} x2={m.dir > 0 ? 270 : 60} y2={m.y + 20} class={`d-line ${m.dir > 0 ? 'd-blue' : 'd-green'}`} marker-end="url(#tu-ar)" />
					<text x="165" y={m.y + 4} class="d-s d-b">{m.t}</text>
				</g>
			))
		}
		<text x="165" y="245" class="d-t">دقيق لكنه أبطأ (مثل البريد المسجّل)</text>

		<line x1="330" y1="15" x2="330" y2="250" class="d-line d-dash" />

		<!-- UDP -->
		<text x="495" y="22" class="d-t d-b d-ltr">UDP</text>
		<text x="390" y="48" class="d-s">المرسل</text>
		<text x="600" y="48" class="d-s">المستقبل</text>
		<line x1="390" y1="55" x2="390" y2="215" class="d-line" />
		<line x1="600" y1="55" x2="600" y2="215" class="d-line" />
		{
			udp.map((m) => (
				<g>
					<line x1="390" y1={m.y} x2="600" y2={m.y + 20} class="d-line d-orange" marker-end="url(#tu-ar)" />
					<text x="495" y={m.y + 4} class="d-s d-b">{m.t}</text>
				</g>
			))
		}
		<text x="495" y="245" class="d-t">سريع لكن بلا تأكيد (مثل البث المباشر)</text>
	</svg>
	<figcaption>ينتظر TCP إشعار استلام (ACK) بعد كل قطعة، فلا يضيع شيء. أما UDP فيرسل الرزم متتالية دون انتظار، فهو أسرع، لكن قد يضيع شيء.</figcaption>
</figure>
