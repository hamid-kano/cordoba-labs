---
// RTS/CTS/DATA/ACK مع جهاز مخفي
const L = 90, M = 330, R = 570;
const msgs = [
	{ from: L, to: M, t: '1. RTS: «أريد أن أرسل»', c: 'd-blue' },
	{ from: M, to: L, t: '2. CTS: «تفضّل»', c: 'd-green', also: true },
	{ from: L, to: M, t: '3. DATA: البيانات', c: 'd-orange' },
	{ from: M, to: L, t: '4. ACK: «وصلت ✔»', c: 'd-green' },
];
---

<figure class="wl-fig">
	<svg viewBox="0 0 660 300" role="img" aria-label="يرسل A الإطار RTS إلى نقطة الوصول، فترد بـ CTS يسمعه A و C، فينتظر C، ثم DATA و ACK">
		<defs>
			<marker id="rc-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="d-arrow" />
			</marker>
		</defs>
		<rect x={L - 45} y="10" width="90" height="34" rx="8" class="d-box2" />
		<text x={L} y="33" class="d-t d-b">📱 A (المرسل)</text>
		<rect x={M - 55} y="10" width="110" height="34" rx="8" class="d-box" />
		<text x={M} y="33" class="d-t d-b">📶 نقطة الوصول</text>
		<rect x={R - 55} y="10" width="110" height="34" rx="8" class="d-box2" />
		<text x={R} y="33" class="d-t d-b">💻 C (مخفي)</text>
		<line x1={L} y1="44" x2={L} y2="270" class="d-line d-dash" />
		<line x1={M} y1="44" x2={M} y2="270" class="d-line d-dash" />
		<line x1={R} y1="44" x2={R} y2="270" class="d-line d-dash" />
		{
			msgs.map((m, i) => {
				const y = 80 + i * 48;
				return (
					<g>
						<line x1={m.from} y1={y} x2={m.to} y2={y + 14} class={`d-line ${m.c}`} marker-end="url(#rc-ar)" />
						<text x={(m.from + m.to) / 2} y={y - 4} class="d-s d-b">{m.t}</text>
						{m.also && <line x1={M} y1={y} x2={R} y2={y + 14} class={`d-line ${m.c}`} marker-end="url(#rc-ar)" />}
						{m.also && <text x={(M + R) / 2} y={y - 4} class="d-s d-b">وصل CTS إلى C أيضاً</text>}
					</g>
				);
			})
		}
		<rect x={R - 70} y="150" width="140" height="110" rx="8" class="rc-wait" />
		<text x={R} y="196" class="d-t d-b">⏳ C صامت</text>
		<text x={R} y="218" class="d-s">حتى ينتهي A</text>
		<text x="330" y="292" class="d-s">A و C بعيدان ولا يسمع أحدهما الآخر، لكن كليهما يسمع نقطة الوصول</text>
	</svg>
	<figcaption>المشكلة: A و C بعيدان ولا يسمع أحدهما الآخر، فقد يرسلان معاً فيحدث تصادم عند نقطة الوصول (مشكلة <strong>الجهاز المخفي</strong>). الحل: ترسل نقطة الوصول CTS، فيسمعه C ويصمت.</figcaption>
</figure>

<style>
	.rc-wait { fill: #e5534b; opacity: 0.12; stroke: #e5534b; stroke-dasharray: 5 4; }
</style>
