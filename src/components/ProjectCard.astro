---
// بطاقة «مشروع المادة» (بالرئيسية وبخطة كل مادة): عنوان، ووصف قصير، وشرائح المعلومات، وحالة التسجيل الحية من Firestore، وزر.
// الحالة بتنقرا من proj/{course} (نفس منطق ProjectHub)، وإذا ما في إعدادات أو ما في Firebase بتقول «التسجيل مغلق حالياً».
import { COURSES, type Course } from '../scripts/projects';
interface Props { course: Course; href: string; compact?: boolean }
const { course, href, compact = false } = Astro.props;
const INFO: Record<Course, { icon: string; title: string; text: string; chips: string[] }> = {
	os1: {
		icon: '🖥️',
		title: 'محاكي جدولة المعالج',
		text: 'اكتب برنامجاً يجدول العمليات بـ FCFS وبخوارزمية تختارها، ويرسم مخطط Gantt، ويقارن بين الخوارزميتين على بيانات خاصة بمجموعتك.',
		chips: ['طالبان أو 3', '5 خوارزميات', '10 علامات'],
	},
	rts: {
		icon: '⏱️',
		title: 'جهاز بأربع مهام',
		text: 'اختر جهازاً، وخذ أرقام مهام خاصة بمجموعتك، ثم احسب وارسم الجدولة بـ RM و EDF، وطبّق مشروعك في Wokwi.',
		chips: ['طالبان أو 3', '5 أجهزة', '10 علامات'],
	},
};
const info = INFO[course];
const opts = COURSES[course].opts.map((o) => COURSES[course].optName[o]);
const courseName = course === 'os1' ? 'نظم التشغيل 1' : 'نظم الزمن الحقيقي';
---

<a class:list={['not-content', 'pjc', { 'pjc-compact': compact }]} href={href} data-pjc={course}>
	<span class="pjc-top">
		<span class="pjc-icon" aria-hidden="true">{info.icon}</span>
		<span class="pjc-head">
			<span class="pjc-kicker">مشروع المادة · {courseName}</span>
			<span class="pjc-title">{info.title}</span>
		</span>
		<span class="pjc-state" data-pjc-state>…</span>
	</span>
	<span class="pjc-text">{info.text}</span>
	{!compact && <span class="pjc-opts">{opts.map((o) => <span>{o}</span>)}</span>}
	<span class="pjc-foot">
		<span class="pjc-chips">{info.chips.map((c) => <span>{c}</span>)}</span>
		<span class="pjc-go">التسجيل والتفاصيل <span aria-hidden="true">←</span></span>
	</span>
</a>

<style is:global>
	.pjc {
		display: flex; flex-direction: column; gap: 0.7rem; padding: 1.1rem 1.2rem; border-radius: 1rem; text-decoration: none; color: var(--sl-color-white);
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		background:
			radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--sl-color-accent) 18%, transparent) 0%, transparent 55%),
			var(--sl-color-gray-6);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--sl-color-accent) 25%, transparent) inset;
		transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.pjc:hover { transform: translateY(-2px); border-color: var(--sl-color-accent); box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--sl-color-accent) 70%, transparent); color: var(--sl-color-white); }
	.pjc:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
	.pjc-top { display: flex; align-items: center; gap: 0.75rem; }
	.pjc-icon { flex: none; display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 0.8rem; font-size: 1.5rem; background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent); }
	.pjc-head { display: flex; flex-direction: column; min-width: 0; flex: 1; }
	.pjc-kicker { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); font-weight: 600; }
	.pjc-title { font-size: var(--sl-text-xl); font-weight: 700; line-height: 1.3; }
	.pjc-state { flex: none; font-size: var(--sl-text-xs); font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--sl-color-gray-5); color: var(--sl-color-gray-2); white-space: nowrap; }
	.pjc-state.open { background: #2fb36b; color: #fff; }
	.pjc-state.soon { background: #e0a100; color: #1b1b1b; }
	.pjc-text { color: var(--sl-color-gray-2); line-height: 1.7; font-size: var(--sl-text-sm); }
	.pjc-opts { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.pjc-opts span { font-size: var(--sl-text-xs); padding: 0.15rem 0.55rem; border-radius: 999px; border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-2); }
	.pjc-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: 0.1rem; }
	.pjc-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.pjc-chips span { font-size: var(--sl-text-xs); font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 0.4rem; background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent); color: var(--sl-color-accent-high); }
	.pjc-go { font-weight: 700; color: var(--sl-color-accent-high); white-space: nowrap; }
	.pjc:hover .pjc-go span { display: inline-block; transform: translateX(-3px); }
	.pjc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; margin-top: 1rem; }
	@media (max-width: 40rem) { .pjc-top { flex-wrap: wrap; } .pjc-head { flex: 1 1 calc(100% - 3.6rem); } .pjc-state { order: 3; margin-inline-start: 3.55rem; } .pjc-title { font-size: var(--sl-text-lg); } }
</style>

<script>
	import { getFirestore, doc, getDoc, Timestamp } from 'firebase/firestore/lite';
	import { app } from '../scripts/quizStore';
	import { firebaseReady } from '../data/firebase-config';
	import { regState, subState, fmtWhen, left, DEFAULT_CAP, type ProjSettings, type Mode } from '../scripts/projects';

	const cards = document.querySelectorAll<HTMLElement>('[data-pjc]');
	if (cards.length) {
		const db = firebaseReady() ? getFirestore(app()) : null;
		const toDate = (v: unknown) => (v instanceof Timestamp ? v.toDate() : null);
		const mode = (v: unknown): Mode => (v === 'open' || v === 'auto' ? v : 'closed');
		cards.forEach(async (card) => {
			const el = card.querySelector<HTMLElement>('[data-pjc-state]')!;
			const show = (t: string, cls = '', title = '') => { el.textContent = t; el.className = 'pjc-state' + (cls ? ' ' + cls : ''); el.title = title; };
			if (!db) return show('التسجيل مغلق');
			try {
				const s = await getDoc(doc(db, 'proj', card.dataset.pjc!));
				if (!s.exists()) return show('التسجيل مغلق');
				const x = s.data();
				const st: ProjSettings = { regFrom: toDate(x.regFrom), regTo: toDate(x.regTo), subTo: toDate(x.subTo), regMode: mode(x.regMode), subMode: mode(x.subMode), cap: typeof x.cap === 'number' ? x.cap : DEFAULT_CAP };
				const r = regState(st), sub = subState(st);
				if (r.open) show(r.until ? `التسجيل مفتوح · باقي ${left(r.until)}` : 'التسجيل مفتوح', 'open', r.until ? `يُغلق ${fmtWhen(r.until)}` : '');
				else if (r.soon) show('التسجيل قريباً', 'soon', `يُفتح ${fmtWhen(r.soon)}`);
				else if (sub.open) show(sub.until ? `التسليم مفتوح · باقي ${left(sub.until)}` : 'التسليم مفتوح', 'open', sub.until ? `آخر موعد ${fmtWhen(sub.until)}` : '');
				else show('التسجيل مغلق');
			} catch (e) {
				console.warn('project card', e);
				show('التسجيل مغلق');
			}
		});
	}
</script>
