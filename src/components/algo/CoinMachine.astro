---
// آلة الفكّة: الجشع (أكبر قطعة أولاً) مقابل الحل الأمثل (برمجة ديناميكية)، لأنظمة قطع مختلفة.
// زر بيدوّر على أول مبلغ بيفشل فيه الجشع. المحرك greedyCoins/minCoins/firstGreedyFail بـ src/scripts/algo.ts.
const SETS = [[1, 5, 10, 25], [1, 3, 4], [1, 7, 10]];
---

<div class="not-content wl-box" data-coins data-sets={JSON.stringify(SETS)}>
	<h4>🪙 آلة الفكّة</h4>
	<div class="wl-row">
		<span>القطع المتوفرة:</span>
		{SETS.map((s, i) => <button type="button" class={`wl-btn${i === 0 ? ' primary' : ''}`} data-set={i}><bdi dir="ltr">{s.join(', ')}</bdi></button>)}
		<input type="text" data-k="custom" dir="ltr" placeholder="1, 6, 9" style="width:6.5rem" />
		<button type="button" class="wl-btn" data-custom>استخدم</button>
	</div>
	<label class="ai-slider"><span>المبلغ<output data-o="amt"></output></span><input type="range" min="1" max="99" step="1" value="63" data-k="amt" /></label>
	<div class="cm-row"><b>الجشع: أكبر قطعة أولاً</b><div class="cm-coins" data-out="g"></div></div>
	<div class="cm-row"><b>أقل عدد ممكن</b><div class="cm-coins" data-out="o"></div></div>
	<div class="wl-row"><button type="button" class="wl-btn" data-hunt>🔎 ابحث عن أول مبلغ يفشل فيه الجشع</button></div>
	<p class="wl-msg" data-out="msg"></p>
</div>

<style is:global>
	.cm-row { display: flex; flex-direction: column; gap: 0.25rem; }
	.cm-row > b { font-size: var(--sl-text-sm); }
	.cm-coins { display: flex; flex-wrap: wrap; gap: 4px; min-height: 2.4rem; align-items: center; }
	.cm-coins i { font-style: normal; width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.85rem; color: #111; background: radial-gradient(circle at 35% 35%, #ffe08a, #e0a030); border: 2px solid #b07a10; animation: sq-in 0.2s; }
	.cm-coins small { margin-inline-start: 0.5rem; font-weight: 700; }
	@keyframes sq-in { from { transform: scale(0.6); opacity: 0; } }
</style>

<script>
	import { greedyCoins, minCoins, firstGreedyFail, arCount } from '../../scripts/algo';
	document.querySelectorAll<HTMLElement>('[data-coins]').forEach((root) => {
		const SETS: number[][] = JSON.parse(root.dataset.sets!);
		const $ = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const amt = root.querySelector<HTMLInputElement>('[data-k="amt"]')!;
		let coins = SETS[0];
		const n = (k: number) => arCount(k, 'قطعة واحدة', 'قطعتان', 'قطع', 'قطعة');
		const show = (el: HTMLElement, list: number[]) => (el.innerHTML = list.length ? list.map((c) => `<i>${c}</i>`).join('') + `<small>${n(list.length)}</small>` : '<small>لا يمكن تكوين المبلغ!</small>');
		const draw = () => {
			const a = +amt.value;
			root.querySelector('[data-o="amt"]')!.textContent = String(a);
			const g = greedyCoins(a, coins), o = minCoins(a, coins);
			show($('g'), g); show($('o'), o);
			const msg = $('msg');
			if (!g.length && o.length) { msg.className = 'wl-msg wl-bad'; msg.textContent = 'الجشع علق! أخذ قطعاً كبيرة ثم لم يستطع أن يكمل، مع أن الحل موجود.'; }
			else if (g.length === o.length) { msg.className = 'wl-msg wl-good'; msg.textContent = `الجشع وجد أفضل حل: ${n(g.length)}.`; }
			else { msg.className = 'wl-msg wl-bad'; msg.textContent = `✗ الجشع أخذ ${n(g.length)}، والأفضل ${n(o.length)}! أخذ القطعة الأكبر بدا ذكياً، لكنه أفسد الباقي.`; }
		};
		const use = (cs: number[]) => { coins = [...new Set(cs)].filter((x) => x > 0).sort((a, b) => a - b); draw(); };
		root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.addEventListener('click', () => {
			root.querySelectorAll('[data-set]').forEach((x) => x.classList.toggle('primary', x === b));
			use(SETS[+b.dataset.set!]);
			$('msg').textContent += coins.join() === '1,3,4' ? ' جرّب المبلغ 6.' : coins.join() === '1,7,10' ? ' جرّب المبلغ 14.' : '';
		}));
		root.querySelector('[data-custom]')!.addEventListener('click', () => {
			const cs = root.querySelector<HTMLInputElement>('[data-k="custom"]')!.value.split(/[,،\s]+/).map(Number).filter((x) => Number.isInteger(x) && x > 0 && x <= 99);
			if (!cs.length) return;
			if (!cs.includes(1)) cs.push(1);
			root.querySelectorAll('[data-set]').forEach((x) => x.classList.remove('primary'));
			use(cs);
		});
		root.querySelector('[data-hunt]')!.addEventListener('click', () => {
			const f = firstGreedyFail(coins, 99);
			const msg = $('msg');
			if (!f) { draw(); msg.className = 'wl-msg wl-good'; msg.textContent = `لا يوجد مبلغ حتى 99 يفشل فيه الجشع مع القطع ${coins.join('، ')}. مثل هذه الأنظمة اسمها «قانونية»، وأغلب العملات في العالم مصممة لتكون كذلك.`; return; }
			amt.value = String(f);
			draw();
		});
		draw();
	});
</script>
