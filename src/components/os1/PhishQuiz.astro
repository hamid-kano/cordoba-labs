---
// اختبار «حقيقية ولا تصيّد؟» (جلسة الأمن): رسائل وروابط، والطالب بيقرر، وبيطلعله السبب.
---

<div class="not-content wl-box" data-phish>
	<h4>حقيقية أم تصيّد؟</h4>
	<p class="os-hint">قرّر لكل رسالة: آمنة أم محاولة تصيّد؟ ثم اقرأ السبب.</p>
	<div class="os-phish" data-out="list"></div>
	<p class="wl-msg" data-out="score"></p>
</div>

<script>
	const ITEMS: { from: string; text: string; link?: string; phish: boolean; why: string }[] = [
		{ from: 'رسالة SMS', text: 'تم إيقاف حسابك البنكي! حدّث بياناتك خلال ساعة:', link: 'http://bank-sy-update.top/login', phish: true, why: 'المصرف لا يطلب بياناتك عبر رابط. والرابط ليس موقع المصرف، والاستعجال («خلال ساعة») علامة تصيّد.' },
		{ from: 'واتساب من رقم غريب', text: 'مبروك! ربحت آيفون 15 في مسابقة. ادفع 10$ رسوم شحن:', link: 'https://free-iphone-gift.xyz', phish: true, why: 'لم تشارك في أي مسابقة، وهناك طلب مال. جوائز «مجانية» تحتاج إلى دفع = احتيال.' },
		{ from: 'Google', text: 'تسجيل دخول جديد إلى حسابك من جهاز Windows. إذا كان هذا أنت، فلا يلزمك فعل شيء.', link: 'https://myaccount.google.com/notifications', phish: false, why: 'الرابط على google.com الحقيقي، ولا يطلب كلمة سر ولا مالاً، ويقول لك ألا تفعل شيئاً إذا كان هذا أنت.' },
		{ from: 'بريد إلكتروني من «Microsoft»', text: 'امتلأ صندوق بريدك. سجّل الدخول هنا لزيادة المساحة:', link: 'https://micros0ft-support.com/verify', phish: true, why: 'انتبه للعنوان: في micros0ft صفر بدل الحرف o. وهذه حيلة مشهورة.' },
		{ from: 'موقع الجامعة', text: 'صدرت علامات المذاكرة الأولى على موقع العملي:', link: 'https://hamid-kano.github.io/cordoba-labs/', phish: false, why: 'عنوان موقع العملي نفسه الذي تعرفه، ولا يوجد طلب كلمة سر أو بيانات.' },
		{ from: 'رسالة من «صديقك»', text: 'مرحباً، أُرسل إليك رمز تأكيد بالخطأ على رقمك، هل يمكنك أن ترسله لي؟', phish: true, why: 'هذه حيلة لسرقة حسابك: الرمز هو مفتاح حسابك أنت. لا تعطِ أي رمز تأكيد لأحد، حتى لو كان صديقك.' },
	];

	document.querySelectorAll<HTMLElement>('[data-phish]').forEach((root) => {
		const list = root.querySelector<HTMLElement>('[data-out="list"]')!;
		const score = root.querySelector<HTMLElement>('[data-out="score"]')!;
		const answers = new Map<number, boolean>();
		function paint() {
			list.innerHTML = ITEMS.map((it, i) => {
				const a = answers.get(i);
				const answered = a !== undefined;
				const right = answered && a === it.phish;
				return `<div class="os-msg-card ${answered ? (right ? 'ok' : 'no') : ''}">
					<small>${it.from}</small>
					<p>${it.text}${it.link ? `<br><span class="os-link" dir="ltr">${it.link}</span>` : ''}</p>
					${answered
						? `<p class="${right ? 'wl-good' : 'wl-bad'}"><strong>${right ? '✔ صحيح' : '✘ خطأ'}: ${it.phish ? 'تصيّد' : 'آمنة'}.</strong> ${it.why}</p>`
						: `<div class="wl-row"><button type="button" class="wl-btn" data-i="${i}" data-a="0">✔ آمنة</button><button type="button" class="wl-btn" data-i="${i}" data-a="1">🎣 تصيّد</button></div>`}
				</div>`;
			}).join('');
			list.querySelectorAll<HTMLButtonElement>('[data-i]').forEach((b) =>
				b.addEventListener('click', () => {
					answers.set(+b.dataset.i!, b.dataset.a === '1');
					paint();
				}),
			);
			const right = [...answers].filter(([i, a]) => ITEMS[i].phish === a).length;
			score.textContent = answers.size === ITEMS.length ? `النتيجة: ${right} من ${ITEMS.length}` : `أجبت عن ${answers.size} من ${ITEMS.length}`;
			score.className = 'wl-msg ' + (answers.size === ITEMS.length ? (right === ITEMS.length ? 'wl-good' : '') : '');
		}
		paint();
	});
</script>
