---
// قانون أمدال (الجلسة 5): برنامج زمنه 100 ثانية على نواة وحدة، جزء منه بيتقسّم على الخيوط وجزء لازم يضل تسلسلي.
// الطالب بيغيّر النسبة وعدد الأنوية، وبيشوف شريطين (قبل وبعد)، ومنحني التسريع مع سقفه 1 ÷ (1 − p).
// الحساب بـ os1.ts (amdahl، amdahlTime).
---

<div class="not-content wl-box am-lab" data-am-lab>
	<h4>📈 هل تكفي أنوية أكثر؟</h4>
	<p class="se-hint">برنامج يأخذ <strong>100 ثانية</strong> على نواة واحدة. جزء منه يمكن تقسيمه على الخيوط (مثل معالجة صور كثيرة كل واحدة وحدها)، وجزء <strong>يجب</strong> أن يبقى بالترتيب (مثل قراءة الملف أولاً، وجمع النتائج في النهاية).</p>

	<div class="se-predict" data-predict>
		<p><strong>توقّع أولاً:</strong> برنامج <strong>90%</strong> منه يمكن تقسيمه، ولديك <strong>1000</strong> نواة. كم مرة يصبح أسرع؟</p>
		<div class="wl-row">
			<button type="button" class="wl-btn" data-guess="a">قرابة 1000 مرة</button>
			<button type="button" class="wl-btn" data-guess="b">قرابة 100 مرة</button>
			<button type="button" class="wl-btn" data-guess="c">أقل من 10 مرات</button>
		</div>
		<p class="se-note" data-out="guess"></p>
	</div>

	<label class="wl-label"><span>الجزء الذي يمكن تقسيمه: <strong><bdi dir="ltr" data-out="pv">80%</bdi></strong></span>
		<input type="range" min="0" max="100" step="5" value="80" data-in="p" class="am-range" />
	</label>
	<div class="wl-row" role="group" aria-label="عدد الأنوية">
		<span class="se-note">عدد الأنوية:</span>
		{[1, 2, 4, 8, 16, 64, 1000].map((n) => (
			<button type="button" class="wl-btn am-n" data-n={n} aria-pressed={n === 4 ? 'true' : 'false'}>{n}</button>
		))}
	</div>

	<div class="am-bars" dir="ltr">
		<div class="am-row"><span class="am-lbl">1 نواة</span><div class="am-bar" data-out="bar1"></div><span class="am-t">100 s</span></div>
		<div class="am-row"><span class="am-lbl" data-out="nl">4 أنوية</span><div class="am-bar" data-out="barn"></div><span class="am-t" data-out="tn"></span></div>
	</div>
	<div class="am-key"><span><i class="s"></i>يجب أن يبقى بالترتيب</span><span><i class="p"></i>مقسّم على الأنوية</span></div>

	<div class="wl-grid">
		<div class="wl-out"><span>الزمن الجديد</span><strong data-out="time"></strong></div>
		<div class="wl-out"><span>أسرع بـ</span><strong data-out="speed"></strong></div>
		<div class="wl-out"><span>السقف مهما زادت الأنوية</span><strong data-out="cap"></strong></div>
	</div>

	<figure class="am-chart">
		<svg data-out="chart" viewBox="0 0 360 200" role="img" aria-label="منحني التسريع حسب عدد الأنوية"></svg>
		<figcaption>التسريع حسب عدد الأنوية. الخط المتقطع هو السقف: لا يمكن تجاوزه مهما أضفنا أنوية.</figcaption>
	</figure>
	<p class="wl-msg" data-out="msg"></p>
</div>

<style is:global>
	.am-lab .am-range { width: 100%; accent-color: var(--sl-color-accent); }
	.am-lab .am-bars { display: flex; flex-direction: column; gap: 0.4rem; }
	.am-lab .am-row { display: grid; grid-template-columns: 4.2rem 1fr 3.6rem; gap: 0.4rem; align-items: center; font-size: var(--sl-text-xs); }
	.am-lab .am-lbl { direction: rtl; text-align: end; font-weight: 700; }
	.am-lab .am-t { font-family: var(--sl-font-system-mono); font-weight: 700; }
	.am-lab .am-bar { position: relative; height: 1.8rem; border-radius: 0.3rem; background: var(--sl-color-gray-6); overflow: hidden; display: flex; }
	.am-lab .am-bar i { height: 100%; transition: width 0.45s ease; flex: none; }
	.am-lab .am-bar i.s { background: #e5534b; }
	.am-lab .am-bar i.p { background: repeating-linear-gradient(90deg, #2fb36b 0 calc(var(--w) - 2px), #1a6f42 calc(var(--w) - 2px) var(--w)); }
	.am-lab .am-key { display: flex; gap: 1rem; flex-wrap: wrap; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
	.am-lab .am-key i { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 0.2rem; vertical-align: middle; margin-inline-end: 0.3rem; }
	.am-lab .am-key i.s { background: #e5534b; } .am-lab .am-key i.p { background: #2fb36b; }
	.am-lab .am-chart { margin: 0; }
	.am-lab .am-chart svg { width: 100%; height: auto; display: block; direction: ltr; font-family: var(--sl-font); }
	.am-lab .am-chart figcaption { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.am-lab .am-axis { stroke: var(--sl-color-gray-4); stroke-width: 1; }
	.am-lab .am-grid { stroke: var(--sl-color-gray-6); stroke-width: 1; }
	.am-lab .am-tick { fill: var(--sl-color-gray-3); font-size: 10px; font-family: sans-serif; }
	.am-lab .am-curve { fill: none; stroke: #2fb36b; stroke-width: 3; }
	.am-lab .am-ideal { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.5; stroke-dasharray: 2 3; }
	.am-lab .am-cap { stroke: #e5534b; stroke-width: 2; stroke-dasharray: 6 4; }
	.am-lab .am-dot { fill: #e0a030; stroke: var(--sl-color-black); stroke-width: 2; }
	.am-lab .am-captxt { fill: #e5534b; font-size: 11px; font-weight: 700; font-family: sans-serif; }
</style>

<script>
	import { amdahl, amdahlTime } from '../../scripts/os1';

	const NS = [1, 2, 4, 8, 16, 32, 64];
	const fmt = (x: number) => (Math.round(x * 100) / 100).toString();
	const times = (x: number) => { const r = Math.round(x * 100) / 100; return Number.isInteger(r) && r === 2 ? 'مرتان' : Number.isInteger(r) && r >= 3 && r <= 10 ? `${r} مرات` : `${r} مرة`; };
	const coresWord = (n: number) => (n === 1 ? 'نواة' : n === 2 ? 'نواتان' : n <= 10 ? 'أنوية' : 'نواة');

	document.querySelectorAll<HTMLElement>('[data-am-lab]').forEach((root) => {
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const pIn = root.querySelector<HTMLInputElement>('[data-in="p"]')!;
		let n = 4;

		function chart(p: number) {
			const svg = out('chart');
			const L = 34, R = 350, T = 12, B = 176;
			const maxY = 64;
			const X = (k: number) => L + (Math.log2(k) / 6) * (R - L);
			const Y = (s: number) => B - (Math.log2(s) / Math.log2(maxY)) * (B - T);
			let g = '';
			[1, 2, 4, 8, 16, 32, 64].forEach((s) => {
				g += `<line class="am-grid" x1="${L}" x2="${R}" y1="${Y(s)}" y2="${Y(s)}"/><text class="am-tick" x="${L - 5}" y="${Y(s) + 3}" text-anchor="end">${s}×</text>`;
			});
			NS.forEach((k) => (g += `<text class="am-tick" x="${X(k)}" y="${B + 14}" text-anchor="middle">${k}</text>`));
			g += `<line class="am-axis" x1="${L}" x2="${R}" y1="${B}" y2="${B}"/><line class="am-axis" x1="${L}" x2="${L}" y1="${T}" y2="${B}"/>`;
			g += `<path class="am-ideal" d="M ${X(1)} ${Y(1)} L ${X(64)} ${Y(64)}"/>`;
			let d = '';
			for (let i = 0; i <= 60; i++) {
				const k = 2 ** (i / 10);
				d += `${i ? 'L' : 'M'} ${X(k).toFixed(1)} ${Y(amdahl(p, k)).toFixed(1)} `;
			}
			g += `<path class="am-curve" d="${d}"/>`;
			if (p < 1) {
				const cap = 1 / (1 - p);
				if (cap <= maxY) g += `<line class="am-cap" x1="${L}" x2="${R}" y1="${Y(cap)}" y2="${Y(cap)}"/><text class="am-captxt" x="${R}" y="${Y(cap) - 5}" text-anchor="end">${fmt(cap)}× max</text>`;
			}
			const nn = Math.min(n, 64);
			g += `<circle class="am-dot" r="6" cx="${X(nn)}" cy="${Y(amdahl(p, nn))}"/>`;
			svg.innerHTML = g;
		}

		function run() {
			const p = +pIn.value / 100;
			out('pv').textContent = `${pIn.value}%`;
			const serial = 100 * (1 - p);
			const t = amdahlTime(100, p, n);
			const par = t - serial;
			out('bar1').innerHTML = `<i class="s" style="width:${serial}%"></i><i class="p" style="width:${100 * p}%;--w:100%"></i>`;
			out('barn').innerHTML = `<i class="s" style="width:${serial}%"></i><i class="p" style="width:${par}%;--w:${n > 1 && n <= 16 ? 'calc(100% / ' + n + ')' : '100%'}"></i>`;
			out('nl').textContent = `${n} ${coresWord(n)}`;
			out('tn').textContent = `${fmt(t)} s`;
			out('time').textContent = `${fmt(t)} s`;
			out('speed').textContent = times(amdahl(p, n));
			out('cap').textContent = p >= 1 ? 'بلا سقف' : times(1 / (1 - p));
			chart(p);
			const m = out('msg');
			m.className = 'wl-msg';
			if (p === 1) m.textContent = 'برنامج يتقسّم كله: كل نواة تضيفها تسرّعه (وهذا نادر جداً في الواقع).';
			else if (p === 0) m.textContent = 'لا شيء يتقسّم: الأنوية الإضافية لا تفيد أبداً، فالخيوط تنتظر بعضها.';
			else if (n >= 64 && amdahl(p, n) > 0.9 / (1 - p))
				m.textContent = `مع ${n} نواة وصلنا قرب السقف. الجزء الأحمر (${fmt(serial)} ثانية) لا يتقسّم، فهو يحدد السرعة القصوى.`;
			else m.textContent = `الجزء الأحمر لم يتغيّر (${fmt(serial)} ثانية)، والأخضر صار أقصر ${n} مرات.`;
		}

		pIn.addEventListener('input', run);
		root.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((b) =>
			b.addEventListener('click', () => {
				n = +b.dataset.n!;
				root.querySelectorAll('[data-n]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				run();
			}),
		);
		root.querySelectorAll<HTMLButtonElement>('[data-guess]').forEach((b) =>
			b.addEventListener('click', () => {
				root.querySelectorAll('[data-guess]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				const ok = b.dataset.guess === 'c';
				out('guess').textContent = ok
					? '✔ صحيح: 9.91 مرة فقط! الـ 10% التي لا تتقسّم تأخذ 10 ثوانٍ دائماً، فلن ينزل الزمن تحت 10 ثوانٍ. جرّبها: 90% و 1000.'
					: '✘ ليس تماماً. الـ 10% التي لا تتقسّم تأخذ 10 ثوانٍ مهما كان عدد الأنوية. جرّبها: اجعل الجزء 90% واختر 1000.';
			}),
		);
		run();
	});
</script>
