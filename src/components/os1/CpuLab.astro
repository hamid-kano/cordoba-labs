---
// أداء المعالج (الجلسة 6): حاسبة زمن التنفيذ، ومحاكي الـ Pipeline.
interface Props {
	tool: 'time' | 'pipe';
}
const { tool } = Astro.props;
---

{
	tool === 'time' ? (
		<div class="not-content wl-box" data-cpu-time>
			<h4>حاسبة زمن التنفيذ: مين أسرع؟</h4>
			<p class="os-hint">زمن التنفيذ = عدد التعليمات × عدد الدورات لكل تعليمة (CPI) ÷ التردد</p>
			<div class="os-two-cpu">
				{['A', 'B'].map((c) => (
					<div class="os-cpu">
						<strong>المعالج {c}</strong>
						<label class="wl-label"><span>عدد التعليمات (مليون)</span><input class="wl-input" type="number" min="1" data-in={`ic${c}`} value={c === 'A' ? '600' : '1000'} /></label>
						<label class="wl-label"><span>CPI (دورات لكل تعليمة)</span><input class="wl-input" type="number" min="0.1" step="0.1" data-in={`cpi${c}`} value={c === 'A' ? '4' : '1.2'} /></label>
						<label class="wl-label"><span>التردد (GHz)</span><input class="wl-input" type="number" min="0.1" step="0.1" data-in={`f${c}`} value="2" /></label>
						<div class="wl-out"><span>زمن التنفيذ</span><strong data-out={`t${c}`}></strong></div>
					</div>
				))}
			</div>
			<p class="wl-msg" data-out="win"></p>
			<div class="wl-row">
				<button type="button" class="wl-btn" data-ex="riscCisc">مثال: CISC مقابل RISC</button>
				<button type="button" class="wl-btn" data-ex="ghz">مثال: التردد مش كل شي</button>
			</div>
		</div>
	) : (
		<div class="not-content wl-box" data-cpu-pipe>
			<h4>محاكي الـ Pipeline</h4>
			<div class="ai-sliders">
				<label class="ai-slider"><span>عدد التعليمات n<output data-o="n" /></span><input type="range" min="1" max="10" value="5" data-in="n" /></label>
				<label class="ai-slider"><span>عدد المراحل k<output data-o="k" /></span><input type="range" min="2" max="6" value="5" data-in="k" /></label>
			</div>
			<label class="ai-check"><input type="checkbox" data-in="on" checked /> شغّل الـ Pipeline</label>
			<div class="os-pipe-wrap"><table class="os-pipe" data-out="grid"></table></div>
			<div class="wl-grid">
				<div class="wl-out"><span>بدون Pipeline</span><strong data-out="without"></strong></div>
				<div class="wl-out"><span>مع Pipeline</span><strong data-out="with"></strong></div>
				<div class="wl-out"><span>أسرع بـ</span><strong data-out="speed"></strong></div>
			</div>
		</div>
	)
}

<script>
	import { cpuTime, pipeline } from '../../scripts/os1';

	const fmtTime = (s: number) => (s >= 1 ? `${s.toFixed(2)} s` : `${(s * 1000).toFixed(0)} ms`);

	document.querySelectorAll<HTMLElement>('[data-cpu-time]').forEach((root) => {
		const v = (k: string) => +root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value;
		const set = (k: string, x: string) => (root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value = x);
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const EX: Record<string, string[]> = { riscCisc: ['600', '4', '2', '1000', '1.2', '2'], ghz: ['1000', '3', '3', '1000', '1.5', '2'] };
		function run() {
			const tA = cpuTime(v('icA') * 1e6, v('cpiA'), v('fA') * 1e9);
			const tB = cpuTime(v('icB') * 1e6, v('cpiB'), v('fB') * 1e9);
			out('tA').textContent = fmtTime(tA);
			out('tB').textContent = fmtTime(tB);
			const w = out('win');
			if (!Number.isFinite(tA) || !Number.isFinite(tB)) return;
			const fast = tA < tB ? 'A' : 'B';
			const ratio = Math.max(tA, tB) / Math.min(tA, tB);
			w.innerHTML = Math.abs(tA - tB) < 1e-12 ? 'التنين نفس السرعة.' : `المعالج ${fast} أسرع بـ <bdi dir="ltr">${ratio.toFixed(2)}×</bdi>`;
			w.className = 'wl-msg wl-good';
		}
		root.querySelectorAll('input').forEach((i) => i.addEventListener('input', run));
		root.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) =>
			b.addEventListener('click', () => {
				const e = EX[b.dataset.ex!];
				['icA', 'cpiA', 'fA', 'icB', 'cpiB', 'fB'].forEach((k, i) => set(k, e[i]));
				run();
			}),
		);
		run();
	});

	const STAGES = ['IF', 'ID', 'EX', 'MEM', 'WB', 'WB2'];
	document.querySelectorAll<HTMLElement>('[data-cpu-pipe]').forEach((root) => {
		const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		function run() {
			const n = +inp('n').value;
			const k = +inp('k').value;
			const on = inp('on').checked;
			root.querySelector('[data-o="n"]')!.textContent = String(n);
			root.querySelector('[data-o="k"]')!.textContent = String(k);
			const st = k === 6 ? ['IF', 'ID', 'OF', 'EX', 'MEM', 'WB'] : k === 5 ? STAGES.slice(0, 5) : k === 4 ? ['IF', 'ID', 'EX', 'WB'] : k === 3 ? ['IF', 'EX', 'WB'] : ['IF', 'EX'];
			const p = pipeline(n, k);
			const cycles = on ? p.with : p.without;
			let html = '<thead><tr><th></th>' + Array.from({ length: cycles }, (_, c) => `<th>${c + 1}</th>`).join('') + '</tr></thead><tbody>';
			for (let i = 0; i < n; i++) {
				html += `<tr><th>I${i + 1}</th>`;
				for (let c = 0; c < cycles; c++) {
					const s = on ? c - i : c - i * k;
					html += s >= 0 && s < k ? `<td class="s${s}">${st[s]}</td>` : '<td></td>';
				}
				html += '</tr>';
			}
			out('grid').innerHTML = html + '</tbody>';
			out('without').textContent = `n × k = ${p.without}`;
			out('with').textContent = `k + n − 1 = ${p.with}`;
			out('speed').textContent = `${p.speedup.toFixed(2)}×`;
		}
		root.querySelectorAll('input').forEach((i) => i.addEventListener('input', run));
		run();
	});
</script>
