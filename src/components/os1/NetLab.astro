---
// الجلسة 8: tool="request" طلب حقيقي من خادم (زبون وخادم وخدمة ويب)، و tool="caesar" تشفير قيصر، و tool="password" قوة كلمة السر.
interface Props {
	tool: 'request' | 'caesar' | 'password' | 'url';
}
const { tool } = Astro.props;
---

{
	tool === 'url' && (
		<div class="not-content wl-box" data-url-lab>
			<h4>فكّك الرابط</h4>
			<label class="wl-label"><span>الصق أي رابط:</span><input class="wl-input" data-in="u" value="https://api.example.com:443/students/5?year=3&city=Aleppo#marks" /></label>
			<div style="overflow-x:auto"><table class="wl-table" data-out="parts" /></div>
			<p class="wl-msg" data-out="msg" />
		</div>
	)
}
{
	tool === 'request' && (
		<div class="not-content wl-box" data-req-lab>
			<h4>اطلب بيانات من الخادم</h4>
			<p class="os-hint">جهازك هو <strong>الزبون</strong>، وخادم الموقع هو <strong>الخادم</strong>. سنطلب ملف بيانات بصيغة JSON، كما يفعل أي تطبيق على الهاتف.</p>
			<div class="wl-row">
				<button type="button" class="wl-btn primary" data-act="ok">📨 اطلب students.json</button>
				<button type="button" class="wl-btn" data-act="bad">اطلب ملفاً غير موجود</button>
			</div>
			<div class="wl-out"><span>الطلب</span><strong class="os-mono-out" data-out="req">–</strong></div>
			<div class="wl-grid">
				<div class="wl-out"><span>رد الخادم</span><strong data-out="status">–</strong></div>
				<div class="wl-out"><span>الوقت</span><strong data-out="time">–</strong></div>
			</div>
			<pre class="os-json" dir="ltr" data-out="body" />
			<div data-out="table" />
		</div>
	)
}
{
	tool === 'caesar' && (
		<div class="not-content wl-box" data-caesar-lab>
			<h4>تشفير قيصر</h4>
			<div class="wl-grid">
				<label class="wl-label"><span>الرسالة (بالإنكليزية)</span><input class="wl-input" data-in="msg" value="HELLO STUDENTS" /></label>
				<label class="ai-slider"><span>المفتاح (مقدار الإزاحة)<output data-o="k" /></span><input type="range" min="0" max="25" value="3" data-in="k" /></label>
			</div>
			<div class="wl-out"><span>الرسالة المشفّرة</span><strong class="os-mono-out" data-out="enc" /></div>
			<p class="os-hint" data-out="map" />
			<div class="wl-out"><span>فك التشفير بالمفتاح نفسه</span><strong class="os-mono-out" data-out="dec" /></div>
		</div>
	)
}
{
	tool === 'password' && (
		<div class="not-content wl-box" data-pw-lab>
			<h4>ما مدى قوة كلمة السر؟</h4>
			<label class="wl-label"><span>جرّب كلمة سر (لا تكتب كلمة سرك الحقيقية!)</span><input class="wl-input" data-in="pw" value="ahmad123" autocomplete="off" /></label>
			<div class="wl-grid">
				<div class="wl-out"><span>عدد الاحتمالات</span><strong data-out="combos" /></div>
				<div class="wl-out"><span>زمن الكسر بالتجريب</span><strong data-out="time" /></div>
			</div>
			<p class="wl-msg" data-out="tips" />
			<p class="os-hint">الحساب على افتراض جهاز يجرّب 10 مليارات كلمة في الثانية. وكلمات السر المشهورة أو الأسماء تُكسر أسرع بكثير لأنها أول ما يُجرَّب.</p>
		</div>
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-req-lab]').forEach((root) => {
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		async function go(file: string) {
			const url = new URL(`../../files/os1/${file}`, location.href);
			out('req').textContent = `GET ${url.pathname}`;
			out('status').textContent = '…';
			out('body').textContent = '';
			out('table').innerHTML = '';
			const t0 = performance.now();
			try {
				const r = await fetch(url, { cache: 'no-store' });
				out('time').textContent = `${Math.round(performance.now() - t0)} ms`;
				out('status').textContent = `${r.status} ${r.ok ? 'OK ✔' : r.status === 404 ? 'Not Found ✘' : ''}`;
				if (!r.ok) {
					out('body').textContent = 'ردّ الخادم بأن الملف غير موجود (404).';
					return;
				}
				const data = await r.json();
				out('body').textContent = JSON.stringify(data, null, 2);
				out('table').innerHTML =
					'<p class="os-hint">والبيانات نفسها بعد أن «فهمها» التطبيق وعرضها:</p><table class="wl-table"><thead><tr><th>الاسم</th><th>المدينة</th><th>العلامة</th></tr></thead><tbody>' +
					data.students.map((s: { name: string; city: string; mark: number }) => `<tr><td>${s.name}</td><td>${s.city}</td><td>${s.mark}</td></tr>`).join('') +
					'</tbody></table>';
			} catch {
				out('status').textContent = 'لا يوجد اتصال ✘';
				out('body').textContent = 'لم نستطع الوصول إلى الخادم. تأكد من الإنترنت.';
			}
		}
		root.querySelector('[data-act="ok"]')!.addEventListener('click', () => go('students.json'));
		root.querySelector('[data-act="bad"]')!.addEventListener('click', () => go('missing.json'));
	});

	document.querySelectorAll<HTMLElement>('[data-url-lab]').forEach((root) => {
		const inp = root.querySelector<HTMLInputElement>('[data-in="u"]')!;
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
		const row = (name: string, val: string, mean: string) => `<tr><td>${name}</td><td class="wl-mono">${val ? esc(val) : '–'}</td><td>${mean}</td></tr>`;
		function run() {
			let u: URL;
			try {
				u = new URL(inp.value.trim());
			} catch {
				out('parts').innerHTML = '';
				out('msg').textContent = 'هذا ليس رابطاً كاملاً. يجب أن يبدأ بـ https:// أو http://';
				out('msg').className = 'wl-msg wl-bad';
				return;
			}
			const port = u.port || (u.protocol === 'https:' ? '443 (الافتراضي)' : u.protocol === 'http:' ? '80 (الافتراضي)' : '');
			let html = '<thead><tr><th>الجزء</th><th>القيمة</th><th>المعنى</th></tr></thead><tbody>';
			html += row('البروتوكول', u.protocol.replace(':', ''), u.protocol === 'https:' ? 'لغة التخاطب مع الخادم، و s تعني <strong>مشفّر</strong> 🔒' : 'لغة التخاطب مع الخادم، <strong>بدون تشفير</strong> ⚠️');
			html += row('الخادم', u.hostname, 'اسم الجهاز الذي نتخاطب معه');
			html += row('المنفذ', port, 'رقم «الباب» في الخادم');
			html += row('المسار', u.pathname, 'ماذا نريد من الخادم (مثل: الطالب رقم 5)');
			for (const [k, v] of u.searchParams) html += row(`مُعامل: ${esc(k)}`, v, 'معلومة إضافية مع الطلب (بعد ؟)');
			html += row('الجزء الداخلي', u.hash.replace('#', ''), 'مكان داخل الصفحة، ولا يُرسل إلى الخادم');
			out('parts').innerHTML = html + '</tbody>';
			out('msg').textContent = u.protocol === 'https:' ? '✔ الاتصال مشفّر.' : '⚠️ الاتصال غير مشفّر: لا تكتب كلمة سر هنا.';
			out('msg').className = 'wl-msg ' + (u.protocol === 'https:' ? 'wl-good' : 'wl-bad');
		}
		inp.addEventListener('input', run);
		run();
	});

	const shift = (s: string, k: number) => s.replace(/[a-z]/gi, (c) => {
		const base = c <= 'Z' ? 65 : 97;
		return String.fromCharCode(((c.charCodeAt(0) - base + k + 26) % 26) + base);
	});
	document.querySelectorAll<HTMLElement>('[data-caesar-lab]').forEach((root) => {
		const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		function run() {
			const k = +inp('k').value;
			root.querySelector('[data-o="k"]')!.textContent = String(k);
			const enc = shift(inp('msg').value, k);
			out('enc').textContent = enc;
			out('dec').textContent = shift(enc, -k);
			out('map').innerHTML = `أي: <bdi dir="ltr">A → ${shift('A', k)}، B → ${shift('B', k)}، C → ${shift('C', k)} ...</bdi> ولا يوجد إلا 25 مفتاحاً، فيجرّبها المهاجم كلها في ثوانٍ.`;
		}
		root.querySelectorAll('input').forEach((i) => i.addEventListener('input', run));
		run();
	});

	document.querySelectorAll<HTMLElement>('[data-pw-lab]').forEach((root) => {
		const inp = root.querySelector<HTMLInputElement>('[data-in="pw"]')!;
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const human = (s: number) => {
			if (s < 1) return 'أقل من ثانية';
			// [المقدار، المفرد، الجمع (3 لـ 10)]
			const units: [number, string, string][] = [[3.15e7 * 1e6, 'مليون سنة', 'ملايين سنة'], [3.15e7 * 1e3, 'ألف سنة', 'آلاف سنة'], [3.15e7, 'سنة', 'سنوات'], [86400, 'يوم', 'أيام'], [3600, 'ساعة', 'ساعات'], [60, 'دقيقة', 'دقائق'], [1, 'ثانية', 'ثوانٍ']];
			for (const [u, one, few] of units) if (s >= u) {
				const v = Math.round((s / u) * 10) / 10;
				return `${v.toLocaleString('en-US', { maximumFractionDigits: 1 })} ${v >= 3 && v <= 10 && Number.isInteger(v) ? few : one}`;
			}
			return '';
		};
		function run() {
			const p = inp.value;
			let pool = 0;
			const has = { lower: /[a-z]/.test(p), upper: /[A-Z]/.test(p), digit: /\d/.test(p), sym: /[^a-zA-Z0-9]/.test(p) };
			if (has.lower) pool += 26;
			if (has.upper) pool += 26;
			if (has.digit) pool += 10;
			if (has.sym) pool += 33;
			const combos = Math.pow(pool || 1, p.length);
			const exp = p.length * Math.log10(pool || 1);
			out('combos').innerHTML = `<bdi dir="ltr">${pool || 0}<sup>${p.length}</sup> ≈ 10<sup>${exp.toFixed(0)}</sup></bdi>`;
			out('time').textContent = human(combos / 1e10 / 2);
			const tips = [];
			if (p.length < 12) tips.push('أطِلها إلى 12 حرفاً أو أكثر');
			if (!has.upper) tips.push('أضف حروفاً كبيرة');
			if (!has.digit) tips.push('أضف أرقاماً');
			if (!has.sym) tips.push('أضف رموزاً مثل ! أو #');
			const m = out('tips');
			m.textContent = tips.length ? `نصيحة: ${tips.join('، ')}.` : '✔ كلمة سر قوية.';
			m.className = 'wl-msg ' + (tips.length ? 'wl-bad' : 'wl-good');
		}
		inp.addEventListener('input', run);
		run();
	});
</script>
