---
// «لماذا يتجمّد البرنامج؟» (الجلسة 5، الخيوط): تجربة حقيقية مش محاكاة.
// خيط واحد: الحساب الثقيل بيشتغل على خيط الواجهة نفسه، فالصفحة كلها بتتجمّد فعلاً (الكرة بتوقف، والكتابة ما بتبين).
// خيطان: نفس الحساب بـ Web Worker (خيط تاني حقيقي بالمتصفح)، والواجهة بتضل تتحرك.
// منقيس أطول توقف بين إطارين (requestAnimationFrame) لحتى الطالب يشوف الرقم مش بس يحسّه.
// الـ Worker معمول من Blob بنفس الصفحة، فما في ملف خارجي والموقع بيضل يشتغل بلا إنترنت.
---

<div class="not-content wl-box fz-lab" data-fz-lab>
	<h4>🖼️ لماذا يتجمّد البرنامج؟</h4>
	<p class="se-hint">هذه <strong>تجربة حقيقية</strong> وليست محاكاة: برنامج صغير لتعديل الصور، فيه زر يطبّق فلتراً يحتاج قرابة <strong>3 ثوانٍ</strong> من الحساب. جرّبه بخيط واحد ثم بخيطين.</p>

	<div class="wl-row" role="group" aria-label="عدد الخيوط">
		<button type="button" class="wl-btn" data-mode="1" aria-pressed="true">خيط واحد</button>
		<button type="button" class="wl-btn" data-mode="2" aria-pressed="false">خيطان: الواجهة + خيط عامل</button>
	</div>

	<div class="fz-app">
		<div class="fz-bar"><span></span><span></span><span></span><b>محرّر الصور</b></div>
		<div class="fz-body">
			<div class="fz-track" aria-hidden="true"><i data-out="ball">🏀</i></div>
			<div class="fz-clock">الساعة الحيّة: <bdi dir="ltr" data-out="clock">0.0</bdi> ث</div>
			<label class="wl-label"><span>اكتب هنا أثناء تطبيق الفلتر:</span><input class="wl-input fz-type" data-out="type" placeholder="…" autocomplete="off" /></label>
			<div class="fz-prog"><span data-out="prog"></span></div>
			<div class="wl-row">
				<button type="button" class="wl-btn primary" data-act="run">✨ طبّق الفلتر</button>
				<span class="se-note" data-out="state">جاهز</span>
			</div>
		</div>
		<div class="fz-ice" data-out="ice" aria-hidden="true">❄️ لا يستجيب</div>
	</div>

	<div class="fz-threads" aria-hidden="true">
		<div><span>🧵 خيط الواجهة</span><div class="fz-lane" data-lane="ui"></div></div>
		<div data-row="worker" hidden><span>🧵 الخيط العامل</span><div class="fz-lane" data-lane="worker"></div></div>
	</div>

	<div class="wl-grid">
		<div class="wl-out"><span>أطول توقّف للواجهة</span><strong data-out="gap">–</strong></div>
		<div class="wl-out"><span>مدة الحساب</span><strong data-out="work">–</strong></div>
		<div class="wl-out"><span>خيوط المعالج في جهازك</span><strong data-out="hw">–</strong></div>
	</div>
	<p class="wl-msg" data-out="msg"></p>
</div>

<style is:global>
	.fz-lab .fz-app { position: relative; border-radius: 0.6rem; border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-black); overflow: hidden; }
	.fz-lab .fz-bar { display: flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.6rem; background: var(--sl-color-gray-6); font-size: var(--sl-text-sm); }
	.fz-lab .fz-bar span { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--sl-color-gray-4); }
	.fz-lab .fz-bar span:first-child { background: #e5534b; }
	.fz-lab .fz-bar b { margin-inline-start: 0.4rem; }
	.fz-lab .fz-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.75rem; }
	.fz-lab .fz-track { position: relative; height: 2rem; border-radius: 99px; background: var(--sl-color-gray-6); direction: ltr; }
	.fz-lab .fz-track i { position: absolute; top: 50%; left: 0; font-style: normal; font-size: 1.4rem; line-height: 1; transform: translate(0, -50%); will-change: left; }
	.fz-lab .fz-clock { font-size: var(--sl-text-sm); }
	.fz-lab .fz-clock bdi { display: inline-block; direction: ltr; unicode-bidi: isolate; min-width: 3.5ch; font-family: var(--sl-font-system-mono); font-weight: 700; }
	.fz-lab .fz-type { width: 100%; direction: rtl; }
	.fz-lab .fz-prog { height: 0.6rem; border-radius: 99px; background: var(--sl-color-gray-6); overflow: hidden; }
	.fz-lab .fz-prog span { display: block; height: 100%; width: 0; background: var(--sl-color-accent); }
	.fz-lab .fz-ice { position: absolute; inset: 0; display: grid; place-items: center; font-size: 1.3rem; font-weight: 700; color: #fff; background: rgba(120, 170, 220, 0.55); backdrop-filter: grayscale(1); opacity: 0; pointer-events: none; }
	.fz-lab .fz-ice.on { opacity: 1; }
	.fz-lab .fz-threads { display: flex; flex-direction: column; gap: 0.35rem; font-size: var(--sl-text-xs); }
	.fz-lab .fz-threads > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.4rem; align-items: center; }
	.fz-lab .fz-lane { position: relative; height: 1.3rem; border-radius: 0.3rem; background: var(--sl-color-gray-6); overflow: hidden; direction: ltr; }
	.fz-lab .fz-lane i { position: absolute; top: 0; bottom: 0; }
	.fz-lab .fz-lane i.ui { background: #2fb36b; }
	.fz-lab .fz-lane i.busy { background: #e5534b; }
	.fz-lab .fz-lane i.calc { background: #e0a030; }
	.fz-lab .fz-lane em { position: absolute; inset: 0; display: grid; place-items: center; font-style: normal; font-weight: 700; color: #111; font-size: 0.68rem; }
</style>

<script>
	// الحساب نفسه بالخيطين: عمليات رياضية لمدة ms ميلي ثانية، وبيرجع عددها
	const WORK = `function work(ms){const s=performance.now();let n=0,x=0;while(performance.now()-s<ms){for(let i=0;i<2000;i++){x+=Math.sqrt(i*n%97);}n++;}return n;}`;
	const MS = 2800;

	document.querySelectorAll<HTMLElement>('[data-fz-lab]').forEach((root) => {
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
		const lane = (k: string) => root.querySelector<HTMLElement>(`[data-lane="${k}"]`)!;
		let mode: 1 | 2 = 1;
		let busy = false;
		const t0 = performance.now();
		let last = performance.now();
		let gap = 0; // أطول فرق بين إطارين أثناء التجربة
		let measuring = false;
		const work = new Function(`${WORK};return work;`)() as (ms: number) => number;
		let worker: Worker | null = null;

		const hw = navigator.hardwareConcurrency;
		out('hw').textContent = hw ? String(hw) : 'غير معروف';

		// حلقة الواجهة: كرة بتتحرك وساعة. إذا تجمّد خيط الواجهة بيوقفوا فعلاً.
		const ball = out('ball');
		function frame(now: number) {
			const d = now - last;
			if (measuring && d > gap) gap = d;
			last = now;
			const s = (now - t0) / 1000;
			const p = (Math.sin(s * 2.4) + 1) / 2;
			ball.style.left = `calc(${(p * 100).toFixed(2)}% - ${(p * 1.6).toFixed(2)}rem)`;
			out('clock').textContent = s.toFixed(1);
			requestAnimationFrame(frame);
		}
		requestAnimationFrame(frame);

		function lanes(ui: string, wk = '') {
			lane('ui').innerHTML = ui;
			lane('worker').innerHTML = wk;
		}
		function idleLanes() {
			lanes('<i class="ui" style="left:0;width:100%;opacity:.35"></i><em>يرسم الواجهة ويستقبل كتابتك</em>', '<em>ينتظر عملاً</em>');
		}
		idleLanes();

		function finish(n: number, ms: number) {
			// إطار إضافي بعد النهاية لحتى ينحسب آخر توقف
			requestAnimationFrame(() =>
				requestAnimationFrame(() => {
					measuring = false;
					busy = false;
					out('ice').classList.remove('on');
					(out('prog') as HTMLElement).style.width = '100%';
					out('state').textContent = `تم ✔ (${n.toLocaleString('en')} دورة حساب)`;
					out('gap').textContent = `${(gap / 1000).toFixed(2)} s`;
					out('work').textContent = `${(ms / 1000).toFixed(1)} s`;
					(root.querySelector('[data-act="run"]') as HTMLButtonElement).disabled = false;
					const m = out('msg');
					if (mode === 1) {
						lanes('<i class="busy" style="left:0;width:100%"></i><em>مشغول بالحساب: لا يرسم ولا يستقبل شيئاً</em>');
						m.className = 'wl-msg wl-bad';
						m.textContent = `✘ تجمّدت الواجهة ${(gap / 1000).toFixed(1)} ثانية: توقفت الكرة والساعة، وما كتبته ظهر دفعة واحدة بعد النهاية. الخيط الوحيد كان مشغولاً بالحساب.`;
					} else {
						lanes('<i class="ui" style="left:0;width:100%"></i><em>يرسم الواجهة طوال الوقت</em>', '<i class="calc" style="left:0;width:100%"></i><em>يحسب الفلتر</em>');
						m.className = 'wl-msg wl-good';
						m.textContent = `✔ أطول توقّف ${(gap / 1000).toFixed(2)} ثانية فقط، أي لا يُلاحظ. الحساب نفسه أخذ الوقت نفسه تقريباً، لكن في خيط آخر، فبقيت الواجهة تستجيب.`;
					}
				}),
			);
		}

		root.querySelector('[data-act="run"]')!.addEventListener('click', (e) => {
			if (busy) return;
			busy = true;
			(e.currentTarget as HTMLButtonElement).disabled = true;
			gap = 0;
			out('msg').textContent = '';
			const prog = out('prog') as HTMLElement;
			prog.style.width = '0';
			out('gap').textContent = '…';
			out('work').textContent = '…';
			if (mode === 1) {
				out('state').textContent = 'يحسب… (ستتجمّد الصفحة لحظات، هذا مقصود)';
				out('ice').classList.add('on');
				lanes('<i class="busy" style="left:0;width:100%"></i><em>مشغول بالحساب…</em>');
				// منستنى إطارين لحتى تبين رسالة التجمّد قبل ما يبلّش الحساب
				requestAnimationFrame(() =>
					requestAnimationFrame(() => {
						measuring = true;
						last = performance.now();
						const s = performance.now();
						const n = work(MS);
						finish(n, performance.now() - s);
					}),
				);
			} else {
				out('state').textContent = 'يحسب في الخيط العامل… جرّب أن تكتب';
				lanes('<i class="ui" style="left:0;width:100%"></i><em>يرسم الواجهة</em>', '<i class="calc" style="left:0;width:100%"></i><em>يحسب…</em>');
				if (!worker) {
					const src = `${WORK};onmessage=(e)=>{const s=performance.now();const step=e.data/20;let n=0;for(let i=1;i<=20;i++){n+=work(step);postMessage({p:i/20});}postMessage({n,ms:performance.now()-s});};`;
					worker = new Worker(URL.createObjectURL(new Blob([src], { type: 'text/javascript' })));
				}
				measuring = true;
				last = performance.now();
				worker.onmessage = (ev) => {
					if ('p' in ev.data) prog.style.width = `${ev.data.p * 100}%`;
					else finish(ev.data.n, ev.data.ms);
				};
				worker.postMessage(MS);
			}
		});

		root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
			b.addEventListener('click', () => {
				if (busy) return;
				mode = +b.dataset.mode! as 1 | 2;
				root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				(root.querySelector('[data-row="worker"]') as HTMLElement).hidden = mode === 1;
				out('msg').textContent = '';
				out('state').textContent = 'جاهز';
				out('gap').textContent = '–';
				out('work').textContent = '–';
				(out('prog') as HTMLElement).style.width = '0';
				idleLanes();
			}),
		);
	});
</script>
