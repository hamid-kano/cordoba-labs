---
// محاكي PID بالمتصفح (الجلسة 2): نفس step(feedback(pid(P,I,D)*G, 1)) بـ MATLAB.
// النظام: G(s) = 1/(s(0.5s+1))
---

<div class="not-content wl-box" data-pid-lab>
	<h4>جرّب PID في المتصفح</h4>
	<div class="wl-row">
		<span>تجارب الجلسة:</span>
		<button type="button" class="wl-btn" data-p="1,0,0">أ: P=1</button>
		<button type="button" class="wl-btn" data-p="5,0,0">ب: P=5</button>
		<button type="button" class="wl-btn" data-p="5,0,1">ج: P=5، D=1</button>
		<button type="button" class="wl-btn" data-p="5,0.5,1">د: P=5، I=0.5، D=1</button>
	</div>
	<div class="ai-sliders">
		<label class="ai-slider"><span>P: كم أنا بعيد<output data-o="P"></output></span><input type="range" min="0" max="20" step="0.1" value="5" data-k="P" /></label>
		<label class="ai-slider"><span>I: منذ متى وأنا بعيد<output data-o="I"></output></span><input type="range" min="0" max="5" step="0.1" value="0" data-k="I" /></label>
		<label class="ai-slider"><span>D: سرعة اقترابي<output data-o="D"></output></span><input type="range" min="0" max="5" step="0.1" value="1" data-k="D" /></label>
	</div>
	<figure class="ai-chart">
		<svg role="img" aria-label="استجابة النظام مع الزمن" data-chart></svg>
		<figcaption class="ai-legend">
			<span class="ai-c1"><i></i>الخرج y</span>
			<span class="ai-ref"><i class="dash"></i>المطلوب (1)</span>
			<span class="ai-ghost" data-ghost-legend hidden><i class="dash"></i>الرسم المثبّت</span>
		</figcaption>
	</figure>
	<div class="wl-grid ai-metrics">
		<div class="wl-out"><span>التجاوز</span><strong data-r="os"></strong></div>
		<div class="wl-out"><span>زمن الاستقرار</span><strong data-r="ts"></strong></div>
		<div class="wl-out"><span>القيمة النهائية</span><strong data-r="yf"></strong></div>
	</div>
	<p class="wl-msg" data-r="msg"></p>
	<div class="wl-row">
		<button type="button" class="wl-btn" data-pin>📌 ثبّت الرسم للمقارنة</button>
		<button type="button" class="wl-btn" data-unpin hidden>أزل الرسم المثبّت</button>
	</div>
</div>

<script>
	import { stepPid, stepinfo } from '../../scripts/control';
	import { drawChart, num, type Series } from '../../scripts/chart';

	document.querySelectorAll<HTMLElement>('[data-pid-lab]').forEach((root) => {
		const sl = (k: string) => root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
		const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
		let ghost: Series | null = null;
		let last: { t: number[]; y: number[] } = { t: [], y: [] };
		let raf = 0;

		function run() {
			const P = +sl('P').value;
			const I = +sl('I').value;
			const D = +sl('D').value;
			for (const k of ['P', 'I', 'D']) root.querySelector(`[data-o="${k}"]`)!.textContent = sl(k).value;
			const r = stepPid(P, I, D);
			last = r;
			const s = stepinfo(r.t, r.y, 1);
			const unstable = !r.y.every(Number.isFinite) || Math.abs(r.y[r.y.length - 1]) > 10;
			const series: Series[] = [];
			if (ghost) series.push(ghost);
			series.push({ x: r.t, y: r.y, cls: 'ai-c1' });
			drawChart(svg, { series, xMin: 0, xMax: 10, yMin: 0, yMax: Math.max(1.6, Math.min(3, s.peak * 1.05)), xLabel: 't (s)', yLabel: 'y', hlines: [{ y: 1, cls: 'ai-ref' }] });
			out('os').innerHTML = unstable ? '–' : num(s.os, 1, '%');
			out('ts').innerHTML = unstable || !Number.isFinite(s.ts) ? 'لم يستقر' : num(s.ts, 2, 's');
			out('yf').innerHTML = unstable ? '–' : num(s.final, 3);
			const m = out('msg');
			m.className = 'wl-msg';
			if (P === 0) m.textContent = 'بدون P لا يوجد ما يدفع النظام. كبّر P.';
			else if (unstable) m.textContent = 'النظام لا يستقر! خفّف I.';
			else if (s.os > 20) m.textContent = 'تجاوز كبير. جرّب زيادة D (الفرامل) أو تخفيف P.';
			else if (s.ts > 5) m.textContent = 'بطيء جداً. جرّب زيادة P.';
			else {
				m.textContent = 'استجابة جيدة: سريعة وتجاوزها مقبول.';
				m.classList.add('wl-good');
			}
		}
		const schedule = () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(run);
		};
		root.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((i) => i.addEventListener('input', schedule));
		root.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
			b.addEventListener('click', () => {
				const [P, I, D] = b.dataset.p!.split(',');
				sl('P').value = P;
				sl('I').value = I;
				sl('D').value = D;
				run();
			}),
		);
		const pin = root.querySelector<HTMLButtonElement>('[data-pin]')!;
		const unpin = root.querySelector<HTMLButtonElement>('[data-unpin]')!;
		const legend = root.querySelector<HTMLElement>('[data-ghost-legend]')!;
		pin.addEventListener('click', () => {
			ghost = { x: last.t, y: last.y, cls: 'ai-ghost' };
			unpin.hidden = legend.hidden = false;
			run();
		});
		unpin.addEventListener('click', () => {
			ghost = null;
			unpin.hidden = legend.hidden = true;
			run();
		});
		run();
		let lastW = innerWidth;
		addEventListener('resize', () => {
			if (innerWidth !== lastW) {
				lastW = innerWidth;
				run();
			}
		});
	});
</script>
