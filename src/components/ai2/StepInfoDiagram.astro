---
// استجابة الخطوة لنظام الجلسة 1 بحلقة مغلقة: T(s) = 2/(s²+2s+2)، وعليها قيم stepinfo.
// المنحنى محسوب بالشكل المغلق y(t) = 1 − e^(−t)(cos t + sin t)، والأرقام المكتوبة هي يلي بيطبعها MATLAB.
const y = (t: number) => 1 - Math.exp(-t) * (Math.cos(t) + Math.sin(t));
const X0 = 50, X1 = 590, TMAX = 6;
const Y0 = 330, SC = 252; // y = 0 عند 330، وكل 1 = 252 بكسل
const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
const py = (v: number) => Y0 - v * SC;
const cross = (target: number) => { let a = 0, b = 2; for (let i = 0; i < 50; i++) { const m = (a + b) / 2; if (y(m) < target) a = m; else b = m; } return a; };
const t10 = cross(0.1), t90 = cross(0.9);
const tp = Math.PI, ts = 4.2163;
const path = Array.from({ length: 241 }, (_, i) => { const t = (i / 240) * TMAX; return `${i ? 'L' : 'M'}${px(t).toFixed(1)} ${py(y(t)).toFixed(1)}`; }).join(' ');
const f = (n: number) => n.toFixed(1);
---

<figure class="wl-fig">
	<svg class="d-big" viewBox="0 0 640 400" role="img" aria-label="منحنى استجابة الخطوة يرتفع إلى 1 ويتجاوزه قليلاً ثم يستقر، ومعلّم عليه زمن الصعود والقمة والتجاوز وزمن الاستقرار">
		<defs>
			<marker id="si-ar" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="d-arrow"></path>
			</marker>
		</defs>
		<!-- المحاور -->
		<line x1={X0} y1={Y0} x2={X1} y2={Y0} class="d-line"></line>
		<line x1={X0} y1={Y0} x2={X0} y2={py(1.15)} class="d-line"></line>
		{[0, 1, 2, 3, 4, 5, 6].map((t) => <text x={px(t)} y={Y0 + 22} class="d-s d-ltr">{t === 6 ? '6 s' : t}</text>)}
		{[0, 0.5, 1].map((v) => <text x={X0 - 8} y={py(v) + 5} class="d-s d-ltr d-end">{v}</text>)}

		<!-- المطلوب ومجال ±2% -->
		<line x1={X0} y1={py(1)} x2={X1} y2={py(1)} class="d-line d-dash"></line>
		<line x1={X0} y1={py(1.02)} x2={X1} y2={py(1.02)} class="d-line" style="stroke-dasharray:2 4;opacity:.6"></line>
		<line x1={X0} y1={py(0.98)} x2={X1} y2={py(0.98)} class="d-line" style="stroke-dasharray:2 4;opacity:.6"></line>
		<text x={X1 + 6} y={py(1) + 5} class="d-s d-ltr d-start">±2%</text>
		<text x="115" y={py(1.02) - 9} class="d-s">المطلوب = 1</text>

		<!-- المنحنى -->
		<path d={path} class="d-line d-blue" style="stroke-width:3"></path>

		<!-- زمن الصعود -->
		<line x1={px(t10)} y1={py(y(t10))} x2={px(t10)} y2={py(0.05)} class="d-line d-green d-dash"></line>
		<line x1={px(t90)} y1={py(y(t90))} x2={px(t90)} y2={py(0.05)} class="d-line d-green d-dash"></line>
		<line x1={px(t10)} y1={py(0.05)} x2={px(t90)} y2={py(0.05)} class="d-line d-green" marker-start="url(#si-ar)" marker-end="url(#si-ar)"></line>
		<text x={f((px(t10) + px(t90)) / 2 + 40)} y={py(0.05) - 10} class="d-s d-ltr d-b">RiseTime = 1.52 s</text>
		<circle cx={px(t10)} cy={py(0.1)} r="4" class="d-fgreen"></circle>
		<circle cx={px(t90)} cy={py(0.9)} r="4" class="d-fgreen"></circle>
		<text x={px(t90) - 10} y={py(0.9) + 5} class="d-s d-ltr d-end">90%</text>
		<text x={px(t10) - 7} y={py(0.1) - 6} class="d-s d-ltr d-end">10%</text>

		<!-- القمة والتجاوز -->
		<line x1={px(tp)} y1={py(y(tp))} x2={px(tp)} y2={Y0} class="d-line d-orange d-dash"></line>
		<circle cx={px(tp)} cy={py(y(tp))} r="6" class="d-forange"></circle>
		<text x={px(tp)} y="22" class="d-s d-ltr d-b">Peak = 1.043</text>
		<text x={px(tp)} y="44" class="d-s d-ltr d-b" style="fill:#e5534b">Overshoot = 4.3%</text>
		<text x={px(tp)} y={Y0 + 48} class="d-s d-ltr d-b" style="fill:#e0a030">PeakTime = 3.13 s</text>

		<!-- زمن الاستقرار -->
		<line x1={px(ts)} y1={py(1.1)} x2={px(ts)} y2={Y0} class="d-line d-red d-dash"></line>
		<text x={px(ts) + 8} y={py(1) + 34} class="d-s d-ltr d-start d-b" style="fill:#e5534b">SettlingTime</text>
		<text x={px(ts) + 8} y={py(1) + 56} class="d-s d-ltr d-start d-b" style="fill:#e5534b">= 4.22 s</text>
	</svg>
	<figcaption>
		<strong>الأخضر:</strong> زمن الصعود من 10% إلى 90%. <strong>البرتقالي:</strong> أعلى نقطة ووقتها. <strong>الأحمر:</strong> بعده يبقى الخرج داخل المجال ±2% حول المطلوب.
	</figcaption>
</figure>
