---
// جدول كلمات مجموعة وحدة (صفحة «بطاقة الكلمات»). البيانات من src/data/ai2-words.ts
import { words, sessionSlugs, type WordGroup } from '../../data/ai2-words';

interface Props {
	group: WordGroup;
}
const { group } = Astro.props;
const list = words.filter((w) => w.group === group);
// النص بين backticks بيطلع كود معزول، لحتى ما ينقلب جوّا الجملة العربية
const parts = (t: string) => t.split('`').map((x, i) => ({ x, code: i % 2 === 1 }));
---

<table class="kw-table">
	<thead>
		<tr><th>الكلمة</th><th>بالعربي</th><th>شو بتعمل</th><th>الجلسة</th></tr>
	</thead>
	<tbody>
		{
			list.map((w) => (
				<tr>
					<td><code>{w.w}</code></td>
					<td>{w.ar ?? '–'}</td>
					<td>{parts(w.def).map((p) => (p.code ? <code>{p.x}</code> : p.x))}</td>
					<td><a href={`../${sessionSlugs[w.s]}/`}>{w.s}</a></td>
				</tr>
			))
		}
	</tbody>
</table>
