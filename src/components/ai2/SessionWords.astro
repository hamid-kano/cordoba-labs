---
// مربع «كلمات هالجلسة»: الكلمات يلي بتمر أول مرة بهالجلسة، وكل وحدة بتنكبس وبيطلع شرحها.
import Term from '../Term.astro';
import { words } from '../../data/ai2-words';

interface Props {
	s: number;
}
const { s } = Astro.props;
const list = words.filter((w) => w.s === s);
// الكود بين backticks بينعزل بعلامات اتجاه (LRI ... PDI) لأن نافذة التعريف نص عادي
const [LRI, PDI] = [String.fromCharCode(0x2066), String.fromCharCode(0x2069)];
const plain = (t: string) => t.replace(/`([^`]+)`/g, `${LRI}$1${PDI}`);
---

{
	list.length > 0 && (
		<aside class="session-words" aria-label="كلمات هذه الجلسة">
			<p class="sw-title">🔤 كلمات هذه الجلسة <span>اضغط على أي كلمة لترى معناها</span></p>
			<div class="sw-chips">
				{list.map((w) => (
					<Term t={w.w} en={w.ar} def={plain(w.def)} />
				))}
			</div>
			<p class="sw-more">
				<a href="../keywords/">كل الكلمات في بطاقة واحدة قابلة للطباعة ←</a>
			</p>
		</aside>
	)
}
