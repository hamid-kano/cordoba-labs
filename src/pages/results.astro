---
// صفحة نتائج الاختبارات للمدرّس: تسجيل دخول بـ Google، والقراءة مسموحة بس لـ TEACHER_EMAIL (بقواعد Firestore).
// مش ظاهرة بالقائمة ولا بالبحث، والطلاب لو فتحوها ما بيشوفوا شي.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'نتائج الاختبارات', pagefind: false, head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }] }}>
	<div class="not-content wl-box rs" data-results>
		<div class="wl-row" data-out-row>
			<button type="button" class="wl-btn primary" data-login>تسجيل الدخول بحساب Google</button>
			<button type="button" class="wl-btn" data-logout hidden>تسجيل الخروج</button>
			<span class="se-note" data-out="who"></span>
		</div>
		<p class="wl-msg" data-out="msg"></p>
		<div data-panel hidden>
			<div class="rs-filters">
				<label>المادة <select data-f="course"><option value="">الكل</option><option value="ai2">الذكاء الصنعي 2</option><option value="wireless">الشبكات اللاسلكية</option><option value="os1">نظم التشغيل 1</option><option value="rts">نظم الزمن الحقيقي</option></select></label>
				<label>الاختبار <select data-f="quiz"><option value="">الكل</option></select></label>
				<label>بحث <input type="search" data-f="q" placeholder="اسم أو رقم جامعي" /></label>
			</div>
			<div class="wl-row">
				<button type="button" class="wl-btn primary" data-view="student">حسب الطالب</button>
				<button type="button" class="wl-btn" data-view="best">حسب الاختبار</button>
				<button type="button" class="wl-btn" data-view="all">كل المحاولات</button>
				<button type="button" class="wl-btn" data-reload>↻ تحديث</button>
				<button type="button" class="wl-btn" data-csv>⬇ تنزيل Excel</button>
			</div>
			<div class="wl-grid">
				<div class="wl-out"><span>محاولات</span><strong data-out="n">0</strong></div>
				<div class="wl-out"><span>طلاب</span><strong data-out="students">0</strong></div>
				<div class="wl-out"><span>متوسط العلامة</span><strong data-out="avg">—</strong></div>
			</div>
			<div class="wl-scroll"><table class="wl-table rs-t" data-out="table"></table></div>
		</div>
	</div>
</StarlightPage>

<style is:global>
	.rs-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.5rem; }
	.rs-filters label { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--sl-text-sm); }
	.rs-filters select, .rs-filters input { padding: 0.35rem 0.5rem; border-radius: 0.4rem; border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-bg); color: var(--sl-color-white); }
	.rs-t { width: 100%; font-size: var(--sl-text-sm); }
	.rs-del { padding: 0.1rem 0.45rem; }
	.rs-t td.mk { white-space: nowrap; }
	.rs-t td.num { direction: ltr; text-align: right; white-space: nowrap; }
	.rs-t td.lo { color: #e5534b; font-weight: 700; } .rs-t td.hi { color: #2fb36b; font-weight: 700; }
</style>

<script>
	import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
	import { getFirestore, collection, getDocs, query, orderBy, limit, Timestamp, deleteDoc, doc } from 'firebase/firestore/lite';
	import { app } from '../scripts/quizStore';
	import { firebaseReady, TEACHER_EMAIL } from '../data/firebase-config';

	interface Row { id: string; quiz: string; course: string; name: string; sid: string; score: number; total: number; at: Date | null; client: string; left?: number; secs?: number }
	const COURSE: Record<string, string> = { ai2: 'الذكاء الصنعي 2', wireless: 'الشبكات اللاسلكية', os1: 'نظم التشغيل 1', rts: 'نظم الزمن الحقيقي' };
	// اسم مقروء للاختبار، وأي معرّف غريب (متل محاولات الفحص) بيطلع متل ما هو
	// مفاتيح الاختبارات ما بتتغيّر (لحتى المحاولات القديمة تضل مربوطة بجلستها)، بس رقم الجلسة الظاهر ممكن يتغيّر:
	// نظم التشغيل 1 (2026-10-28): الخطة الجديدة. s3..s8 القديمة صارت بالأرشيف، و s9 = العمليات والخيوط (3)، و s10..s14 = الجلسات 4..8
	const RENAME: Record<string, string> = {
		'os1-s3': 'أرشيف: النسخ الاحتياطي', 'os1-s4': 'أرشيف: قواعد البيانات', 'os1-s5': 'أرشيف: تصميم المعالج', 'os1-s6': 'أرشيف: المعالجات المتعددة', 'os1-s7': 'أرشيف: الأنظمة الموزعة', 'os1-s8': 'أرشيف: الأمن',
		'os1-s9': 'الجلسة 3', 'os1-s10': 'الجلسة 4', 'os1-s11': 'الجلسة 5', 'os1-s12': 'الجلسة 6', 'os1-s13': 'الجلسة 7', 'os1-s14': 'الجلسة 8',
	};
const quizName = (id: string) => { const m = id.match(/^(ai2|wireless|os1|rts)-(exam|s(\d+))$/); return m ? `${COURSE[m[1]]}: ${m[2] === 'exam' ? 'اختبار المادة' : RENAME[id] ?? 'الجلسة ' + m[3]}` : id; };
const mark = (s: number, t: number) => `${s} من ${t}`;
	// الخروج من الصفحة أثناء الاختبار، والمدة (للمحاولات القديمة قبل الاختبار المتسلسل: —)
	const leftCell = (n?: number) => (n === undefined ? '<td class="num">—</td>' : `<td class="num${n ? ' lo' : ''}">${n ? '⚠ ' + n : '0'}</td>`);
	const dur = (s?: number) => (s === undefined ? '—' : `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`);
	const fmtDate = (d: Date | null) => (d ? d.toLocaleString('en-GB', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—');
	const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

	const root = document.querySelector<HTMLElement>('[data-results]')!;
	const $ = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
	const f = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-f="${k}"]`)!;
	const panel = root.querySelector<HTMLElement>('[data-panel]')!;
	const loginBtn = root.querySelector<HTMLButtonElement>('[data-login]')!, logoutBtn = root.querySelector<HTMLButtonElement>('[data-logout]')!;
	let rows: Row[] = [], view: 'student' | 'best' | 'all' = 'student';
	const say = (t: string, k = '') => { const m = $('msg'); m.className = 'wl-msg' + (k ? ' ' + k : ''); m.textContent = t; };

	const filtered = () => {
		const c = f('course').value, qz = f('quiz').value, q = f('q').value.trim().toLowerCase();
		return rows.filter((r) => (!c || r.course === c) && (!qz || r.quiz === qz) && (!q || r.name.toLowerCase().includes(q) || r.sid.includes(q)));
	};
	// ملخص: سطر لكل (طالب، اختبار): أعلى علامة، وعدد المحاولات، وآخر محاولة
	const summary = (rs: Row[]) => {
		const m = new Map<string, { r: Row; best: number; n: number; last: Date | null; left: number }>();
		for (const r of rs) {
			const k = `${r.sid}|${r.quiz}`;
			const e = m.get(k);
			if (!e) m.set(k, { r, best: r.score, n: 1, last: r.at, left: r.left ?? 0 });
			else { e.n++; e.left += r.left ?? 0; if (r.score > e.best) e.best = r.score; if (r.at && (!e.last || r.at > e.last)) e.last = r.at; }
		}
		return [...m.values()].sort((a, b) => a.r.quiz.localeCompare(b.r.quiz) || a.r.name.localeCompare(b.r.name, 'ar'));
	};
	// سطر لكل طالب: كم اختبار مختلف عمل، وكم محاولة، ومعدل أعلى علاماته بالاختبارات، ومجموع الخروج
	const byStudent = (rs: Row[]) => {
		const m = new Map<string, { name: string; quizzes: Set<string>; n: number; best: Map<string, number>; left: number; last: Date | null }>();
		for (const r of rs) {
			let e = m.get(r.sid);
			if (!e) { e = { name: r.name, quizzes: new Set(), n: 0, best: new Map(), left: 0, last: null }; m.set(r.sid, e); }
			e.quizzes.add(r.quiz); e.n++; e.left += r.left ?? 0;
			e.best.set(r.quiz, Math.max(e.best.get(r.quiz) ?? 0, r.score / r.total));
			if (r.at && (!e.last || r.at > e.last)) { e.last = r.at; e.name = r.name; }
		}
		return [...m.entries()].map(([sid, e]) => ({ sid, ...e, avg: Math.round(([...e.best.values()].reduce((a, b) => a + b, 0) / e.best.size) * 100) })).sort((a, b) => a.name.localeCompare(b.name, 'ar'));
	};
	const pctCls = (p: number) => (p >= 80 ? 'hi' : p < 50 ? 'lo' : '');
	const cls = (s: number, t: number) => (s / t >= 0.8 ? 'hi' : s / t < 0.5 ? 'lo' : '');
	const render = () => {
		const rs = filtered();
		$('n').textContent = String(rs.length);
		$('students').textContent = String(new Set(rs.map((r) => r.sid)).size);
		$('avg').textContent = rs.length ? `${Math.round((rs.reduce((s, r) => s + r.score / r.total, 0) / rs.length) * 100)}%` : '—';
		const t = $('table');
		if (view === 'student') {
			t.innerHTML = '<thead><tr><th>الطالب</th><th>الرقم</th><th>اختبارات مختلفة</th><th>المحاولات</th><th>معدل أعلى العلامات</th><th>خروج</th><th>آخر نشاط</th></tr></thead><tbody>' +
				byStudent(rs).map((e) => `<tr><td>${esc(e.name)}</td><td class="num">${esc(e.sid)}</td><td class="num">${e.quizzes.size}</td><td class="num">${e.n}</td><td class="num ${pctCls(e.avg)}">${e.avg}%</td>${leftCell(e.left)}<td class="num">${fmtDate(e.last)}</td></tr>`).join('') + '</tbody>';
		} else if (view === 'all') {
			t.innerHTML = '<thead><tr><th>الوقت</th><th>الطالب</th><th>الرقم</th><th>الاختبار</th><th>العلامة</th><th>خروج</th><th>المدة</th><th></th></tr></thead><tbody>' +
				rs.map((r) => `<tr><td class="num">${fmtDate(r.at)}</td><td>${esc(r.name)}</td><td class="num">${esc(r.sid)}</td><td>${quizName(r.quiz)}</td><td class="mk ${cls(r.score, r.total)}">${mark(r.score, r.total)}</td>${leftCell(r.left)}<td class="num">${dur(r.secs)}</td><td><button type="button" class="wl-btn rs-del" data-del="${r.id}" title="حذف هذه المحاولة">🗑</button></td></tr>`).join('') + '</tbody>';
		} else {
			t.innerHTML = '<thead><tr><th>الطالب</th><th>الرقم</th><th>الاختبار</th><th>أعلى علامة</th><th>المحاولات</th><th>خروج</th><th>آخر محاولة</th></tr></thead><tbody>' +
				summary(rs).map((e) => `<tr><td>${esc(e.r.name)}</td><td class="num">${esc(e.r.sid)}</td><td>${quizName(e.r.quiz)}</td><td class="mk ${cls(e.best, e.r.total)}">${mark(e.best, e.r.total)}</td><td class="num">${e.n}</td>${leftCell(e.left)}<td class="num">${fmtDate(e.last)}</td></tr>`).join('') + '</tbody>';
		}
	};
	const fillQuizzes = () => {
		const c = f('course').value;
		const ids = [...new Set(rows.filter((r) => !c || r.course === c).map((r) => r.quiz))].sort();
		const sel = f('quiz') as HTMLSelectElement, cur = sel.value;
		sel.innerHTML = '<option value="">الكل</option>' + ids.map((id) => `<option value="${id}">${quizName(id)}</option>`).join('');
		if (ids.includes(cur)) sel.value = cur;
	};
	const load = async () => {
		say('جارٍ تحميل النتائج...');
		try {
			const snap = await getDocs(query(collection(getFirestore(app()), 'attempts'), orderBy('at', 'desc'), limit(5000)));
			rows = snap.docs.map((d) => { const x = d.data(); return { ...x, id: d.id, at: x.at instanceof Timestamp ? x.at.toDate() : null } as Row; });
			fillQuizzes(); render();
			say(`✓ ${rows.length} محاولة.`, 'wl-good');
		} catch (e) {
			console.error(e);
			say('تعذّر تحميل النتائج. تأكد أنك مسجّل بحساب المدرّس، وأن قواعد Firestore منشورة.', 'wl-bad');
		}
	};
	const csv = () => {
		const rs = filtered();
		const q = (s: string | number) => `"${String(s).replace(/"/g, '""')}"`;
		const lines = view === 'student'
			? [['الطالب', 'الرقم الجامعي', 'اختبارات مختلفة', 'المحاولات', 'معدل أعلى العلامات %', 'خروج', 'آخر نشاط'], ...byStudent(rs).map((e) => [e.name, e.sid, e.quizzes.size, e.n, e.avg, e.left, fmtDate(e.last)])]
			: view === 'all'
			? [['الوقت', 'الطالب', 'الرقم الجامعي', 'الاختبار', 'العلامة', 'من', 'خروج', 'المدة'], ...rs.map((r) => [fmtDate(r.at), r.name, r.sid, quizName(r.quiz), r.score, r.total, r.left ?? '', dur(r.secs)])]
			: [['الطالب', 'الرقم الجامعي', 'الاختبار', 'أعلى علامة', 'من', 'المحاولات', 'خروج', 'آخر محاولة'], ...summary(rs).map((e) => [e.r.name, e.r.sid, quizName(e.r.quiz), e.best, e.r.total, e.n, e.left, fmtDate(e.last)])];
		// BOM لحتى Excel يقرا العربي صح
		const blob = new Blob(['﻿' + lines.map((l) => l.map(q).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8' });
		const a = document.createElement('a');
		a.href = URL.createObjectURL(blob);
		a.download = `results-${new Date().toISOString().slice(0, 10)}.csv`;
		a.click();
		URL.revokeObjectURL(a.href);
	};

	if (!firebaseReady()) {
		loginBtn.disabled = true;
		say('الحفظ غير مفعّل بعد: عبّئ إعدادات Firebase في src/data/firebase-config.ts.', 'wl-bad');
	} else {
		const auth = getAuth(app());
		onAuthStateChanged(auth, (u) => {
			loginBtn.hidden = !!u; logoutBtn.hidden = !u;
			$('who').textContent = u ? u.email ?? '' : '';
			panel.hidden = !u;
			if (!u) { say('سجّل الدخول بحساب المدرّس لترى النتائج.'); return; }
			if (TEACHER_EMAIL && u.email !== TEACHER_EMAIL) { panel.hidden = true; say('هذا الحساب ليس حساب المدرّس.', 'wl-bad'); return; }
			load();
		});
		loginBtn.addEventListener('click', () => signInWithPopup(auth, new GoogleAuthProvider()).catch((e) => say('فشل تسجيل الدخول: ' + e.code, 'wl-bad')));
		logoutBtn.addEventListener('click', () => signOut(auth));
	}
	root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
		view = b.dataset.view as 'student' | 'best' | 'all';
		root.querySelectorAll('[data-view]').forEach((x) => x.classList.toggle('primary', x === b));
		render();
	}));
	f('course').addEventListener('change', () => { fillQuizzes(); render(); });
	f('quiz').addEventListener('change', render);
	f('q').addEventListener('input', render);
	root.querySelector('[data-reload]')!.addEventListener('click', load);
	// حذف محاولة (للمحاولات التجريبية أو الغلط): بس بجدول «كل المحاولات»
	root.addEventListener('click', async (ev) => {
		const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-del]');
		if (!b) return;
		const r = rows.find((x) => x.id === b.dataset.del);
		if (!r || !confirm(`حذف محاولة «${r.name}» في «${quizName(r.quiz)}» (${mark(r.score, r.total)})؟ لا يمكن التراجع.`)) return;
		b.disabled = true;
		try {
			await deleteDoc(doc(getFirestore(app()), 'attempts', r.id));
			rows = rows.filter((x) => x.id !== r.id);
			fillQuizzes(); render();
			say('✓ حُذفت المحاولة.', 'wl-good');
		} catch (e) { console.error(e); b.disabled = false; say('تعذّر الحذف.', 'wl-bad'); }
	});
	root.querySelector('[data-csv]')!.addEventListener('click', csv);
</script>
